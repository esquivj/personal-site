---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Juan Esquivel',
  url: 'https://juanesquivel.xyz/contact',
};
---

<Layout
  title="Contact"
  description="Email Juan Esquivel about Content, Social, Creative, or Marketing roles in crypto and AI. X and LinkedIn work too."
  canonicalPath="/contact"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <Nav active="contact" />
  <PageHeader
    title="Contact"
    subtitle="Email me about Content, Social, Creative, or Marketing roles in crypto and AI. X and LinkedIn work too."
    compact={true}
  />

  <section class="surface-list">
    <a class="surface-link" href="/JUAN-ESQUIVEL-resume.pdf"><span class="surface-title">Resume</span><span class="surface-arrow">View →</span></a>
    <a class="surface-link" href="mailto:juanesquivel138@gmail.com">
      <div class="surface-body">
        <span class="surface-title">juanesquivel138@gmail.com</span>
        <span class="surface-meta">Email</span>
      </div>
      <span class="surface-arrow">Send ↗</span>
    </a>
    <a class="surface-link" href="https://x.com/0xCadena" target="_blank" rel="noopener">
      <div class="surface-body">
        <span class="surface-title">X (Twitter)</span>
        <span class="surface-meta">@0xCadena</span>
      </div>
      <span class="surface-arrow">Open ↗</span>
    </a>
    <a class="surface-link" href="https://www.linkedin.com/in/esquivj/" target="_blank" rel="noopener">
      <div class="surface-body">
        <span class="surface-title">LinkedIn</span>
        <span class="surface-meta">Professional profile</span>
      </div>
      <span class="surface-arrow">Open ↗</span>
    </a>
  </section>
</Layout>
