---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import UiIcon from '../components/UiIcon.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Juan Esquivel',
  url: 'https://juanesquivel.xyz',
  image: 'https://juanesquivel.xyz/images/avatar.jpg',
  description:
    'Marketer working across brand, product, and narrative with a focus on taste, clarity, and detail.',
  jobTitle: 'Crypto Marketer',
  address: {
    '@type': 'Place',
    name: 'Los Angeles, California',
  },
  sameAs: [
    'https://x.com/0xCadena',
    'https://www.linkedin.com/in/esquivj/',
    'https://github.com/esquivj',
  ],
  knowsAbout: [
    'Crypto Marketing',
    'Brand Strategy',
    'Content Marketing',
    'DAO Governance',
    'Web3',
    'Storytelling',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Juan Esquivel',
  url: 'https://juanesquivel.xyz',
  description:
    'Personal website of Juan Esquivel, a marketer working across brand, product, and narrative.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
  },
};
---

<Layout canonicalPath="/" preloadImages={['/images/avatar.jpg']}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>
  <Nav active="home" />

  <header class="header">
    <div class="header-panel">
      <div class="header-grid">
        <div class="header-main">
          <div class="header-top">
            <div class="header-copy">
              <h1 class="name">Juan Esquivel</h1>
            </div>
          </div>

          <p class="bio">
            Marketer based in Los Angeles. Most recently led marketing at StableLab. Working across
            content, brand, product, and narrative.
          </p>

          <div class="contact-strip">
            <span class="contact-kicker">Connect with me</span>
            <div class="contact-actions">
              <a href="mailto:juanesquivel138@gmail.com" class="social-link-btn">
                <UiIcon name="mail" size={13} class="contact-icon" />
                Email
              </a>
              <a href="https://x.com/0xCadena" target="_blank" rel="noopener" class="social-link-btn">
                <UiIcon name="brand-x" size={13} class="contact-icon" />
                X
              </a>
              <a
                href="https://www.linkedin.com/in/esquivj/"
                target="_blank"
                rel="noopener"
                class="social-link-btn"
              >
                <UiIcon name="brand-linkedin" size={13} class="contact-icon" />
                LinkedIn
              </a>
              <a href="https://github.com/esquivj" target="_blank" rel="noopener" class="social-link-btn">
                <UiIcon name="brand-github" size={13} class="contact-icon" />
                GitHub
              </a>
            </div>
          </div>
        </div>

        <figure class="portrait-panel">
          <div class="avatar avatar--editorial">
            <img
              src="/images/avatar.jpg"
              alt="Juan Esquivel"
              width="160"
              height="160"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>
    </div>
  </header>

  <section class="editorial-index">
    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <span class="margin-note" aria-hidden="true">start here</span>
        <h2>Work</h2>
      </div>
      <div class="folio-copy">
        <p>Three years leading marketing at StableLab across content, brand, product, and GTM.</p>
      </div>
      <div class="folio-actions">
        <a href="/work" class="section-link">Portfolio <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Resume</h2>
      </div>
      <div class="folio-copy">
        <p>Background, roles, and what I've shipped.</p>
      </div>
      <div class="folio-actions">
        <a href="/resume" target="_blank" rel="noopener" class="section-link">View <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Projects</h2>
      </div>
      <div class="folio-copy">
        <p>Projects built outside operating roles and client work.</p>
      </div>
      <div class="folio-actions">
        <a href="/projects" class="section-link">Open <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Essays</h2>
      </div>
      <div class="folio-copy">
        <p>Essays on marketing, tokenization, and building your way in.</p>
      </div>
      <div class="folio-actions">
        <a href="/writing" class="section-link">Read <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Speaking</h2>
      </div>
      <div class="folio-copy">
        <p>Selected conversations on governance, marketing, and narrative.</p>
      </div>
      <div class="folio-actions">
        <a href="/speaking" class="section-link">Watch <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Stack</h2>
      </div>
      <div class="folio-copy">
        <p>The tools and setup I use for work, research, and everyday life.</p>
      </div>
      <div class="folio-actions">
        <a href="/stack" class="section-link">Browse <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor folio-row--last">
      <div class="folio-label">
        <h2>Now</h2>
      </div>
      <div class="folio-copy">
        <p>What I’m working on and paying attention to right now.</p>
      </div>
      <div class="folio-actions">
        <a href="/now" class="section-link">Current <span class="arrow">→</span></a>
      </div>
    </article>
  </section>
</Layout>

<style>
  .header {
    margin-bottom: 4.8rem;
  }

  .header-panel {
    padding-bottom: 1.6rem;
    border-bottom: 1px solid var(--line);
  }

  .header-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 188px;
    gap: clamp(1.4rem, 4vw, 2.35rem);
    align-items: start;
  }

  .header-main {
    min-width: 0;
  }

  .header-top {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.2rem;
  }

  .header-copy {
    min-width: 0;
  }

  .portrait-panel {
    margin: 0;
    padding-top: 0.2rem;
  }

  .avatar {
    width: 136px;
    height: 136px;
    flex-shrink: 0;
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: transform 180ms var(--ease-out);
  }

  .avatar--editorial {
    width: 176px;
    height: 216px;
    border-radius: 0;
    background: #ddd6c9;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .avatar--editorial img {
    filter: saturate(0.78) contrast(1.02) sepia(0.08) brightness(1.02);
    mix-blend-mode: multiply;
  }

  .name {
    font-size: clamp(3.2rem, 8vw, 5.1rem);
    font-weight: 500;
    color: var(--text);
    line-height: 0.93;
    letter-spacing: -0.055em;
  }

  .bio {
    max-width: 36ch;
    font-size: 1.02rem;
    color: var(--text-soft);
    margin-bottom: 1.35rem;
    line-height: 1.74;
  }

  .contact-strip {
    display: flex;
    align-items: center;
    gap: 0.85rem 1rem;
    flex-wrap: wrap;
    padding-top: 1.05rem;
    border-top: 1px solid var(--line);
  }

  .contact-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .contact-kicker::after {
    content: '';
    width: 1.4rem;
    height: 1px;
    background: var(--accent);
  }

  .contact-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem 1rem;
    flex-wrap: wrap;
  }

  .social-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    position: relative;
    padding-bottom: 0.1rem;
    font-family: var(--font-mono);
    color: var(--text-soft);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 150ms var(--ease-out),
      transform 140ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }

  .social-link-btn::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    opacity: 0.55;
    transition: transform 180ms var(--ease-out);
  }

  .contact-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: currentColor;
    display: block;
    transition: transform 160ms var(--ease-out);
  }

  .editorial-index {
    position: relative;
    border-top: 1px solid var(--line);
    margin-top: 0.35rem;
  }

  .editorial-index::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--accent);
    pointer-events: none;
  }

  /* Margin annotation on the Work row */
  .folio-label {
    position: relative;
  }

  .margin-note {
    position: absolute;
    right: calc(100% + 0.65rem);
    top: -0.15em;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.82rem;
    color: var(--accent);
    opacity: 0.6;
    white-space: nowrap;
    transform: rotate(-1.5deg);
    pointer-events: none;
    letter-spacing: 0.01em;
  }

  .margin-note::after {
    content: '\00a0\2192';
  }

  @media (max-width: 560px) {
    .margin-note {
      display: none;
    }
  }

  .folio-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .folio-label h2 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .folio-row--last {
    position: relative;
  }

  .folio-row--last::after {
    content: '';
    position: absolute;
    bottom: -1px;
    right: 0;
    width: 7px;
    height: 7px;
    background: var(--accent);
    pointer-events: none;
  }

  .folio-row--feature {
    padding-top: 1.6rem;
    padding-bottom: 1.7rem;
  }

  .folio-row--feature + .folio-row {
    padding-top: 1.55rem;
  }

  .folio-row--feature .folio-copy p {
    max-width: 34rem;
    font-size: 1rem;
    color: var(--text-soft);
    line-height: 1.66;
  }

  .folio-row--minor .folio-copy p {
    max-width: 34rem;
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--text-soft);
  }

  .folio-row--minor .folio-actions {
    padding-top: 0.05rem;
  }

  .folio-copy span {
    color: var(--text);
    font-style: italic;
  }

  .folio-copy .accent-callout {
    color: var(--accent);
    font-style: normal;
  }

  .folio-credits {
    font-family: var(--font-mono);
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    margin-top: 0.6rem;
    color: var(--text-faint);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .folio-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    min-width: 6.5rem;
  }

  .section-link {
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0;
    font-size: 0.66rem;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 150ms var(--ease-out),
      gap 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }

  .folio-row--feature .section-link {
    color: var(--text);
  }

  .section-link .arrow {
    display: inline-block;
    opacity: 0.8;
    transition: transform 160ms var(--ease-out);
  }

  .section-link--secondary {
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .portrait-panel {
      max-width: 176px;
    }

    .header {
      margin-bottom: 3.35rem;
    }

    .folio-row {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .folio-actions {
      align-items: flex-start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .avatar:hover {
      transform: translateY(-1px) scale(1.01);
    }

    .social-link-btn:hover {
      color: var(--accent);
      transform: translateY(-1px);
      border-color: transparent;
    }

    .social-link-btn:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .social-link-btn:hover .contact-icon {
      transform: translateX(1px);
    }

    .section-link:hover {
      color: var(--text);
      gap: 0.45rem;
      border-color: rgba(20, 19, 17, 0.35);
    }

    .section-link:hover .arrow {
      transform: translateX(2px);
    }

    .section-link--secondary:hover {
      color: var(--text);
    }
  }
</style>
