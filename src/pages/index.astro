---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Juan Esquivel',
  url: 'https://juanesquivel.xyz',
  image: 'https://juanesquivel.xyz/images/avatar.jpg',
  description:
    'Marketer working across brand, product, and narrative with a focus on taste, clarity, and detail.',
  jobTitle: 'Crypto Marketer',
  address: {
    '@type': 'Place',
    name: 'Los Angeles, California',
  },
  sameAs: [
    'https://x.com/0xCadena',
    'https://www.linkedin.com/in/esquivj/',
    'https://github.com/esquivj',
    'https://www.cosmos.so/cadena',
  ],
  knowsAbout: [
    'Crypto Marketing',
    'Brand Strategy',
    'Content Marketing',
    'DAO Governance',
    'Web3',
    'Storytelling',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Juan Esquivel',
  url: 'https://juanesquivel.xyz',
  description:
    'Personal website of Juan Esquivel, a marketer working across brand, product, and narrative.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
  },
};
---

<Layout canonicalPath="/" preloadImages={['/images/avatar.jpg']}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </Fragment>
  <Nav active="home" />

  <header class="header">
    <div class="header-panel">
      <div class="header-grid">
        <div class="header-main">
          <div class="header-top">
            <div class="header-copy">
              <h1 class="name">Juan Esquivel</h1>
            </div>
          </div>

          <p class="bio">
            Marketer based in Los Angeles. Most recently led marketing at StableLab. Working across
            content, brand, product, and narrative.
          </p>

          <div class="contact-strip">
            <span class="contact-kicker">Get in touch</span>
            <a href="https://x.com/0xCadena" target="_blank" rel="noopener">X</a>
            <a href="https://www.linkedin.com/in/esquivj/" target="_blank" rel="noopener"
              >LinkedIn</a
            >
            <a href="https://github.com/esquivj" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.cosmos.so/cadena" target="_blank" rel="noopener">Cosmos</a>
            <button
              class="social-link-btn"
              data-copy="juanesquivel138@gmail.com"
              aria-label="Copy email to clipboard"
            >
              Email
              <span class="copy-toast">Copied</span>
            </button>
          </div>
        </div>

        <figure class="portrait-panel">
          <div class="avatar avatar--editorial">
            <img
              src="/images/avatar.jpg"
              alt="Juan Esquivel"
              width="160"
              height="160"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </figure>
      </div>
    </div>
  </header>

  <section class="editorial-index">
    <article class="folio-row folio-row--feature">
      <div class="folio-label">
        <h2>Work</h2>
      </div>
      <div class="folio-copy">
        <p>Three years leading marketing at StableLab across services, product, and GTM.</p>
        <div class="folio-credits">
          <span>StableLab — Head of Marketing</span>
          <span>Boardroom — Content Lead</span>
        </div>
      </div>
      <div class="folio-actions">
        <a href="/work" class="section-link">Portfolio <span class="arrow">→</span></a>
        <a
          href="/resume"
          target="_blank"
          rel="noopener"
          class="section-link section-link--secondary"
          >Resume <span class="arrow">→</span></a
        >
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Projects</h2>
      </div>
      <div class="folio-copy">
        <p>Independent projects, starting with <span class="accent-callout">tokenizationmap.com</span>.</p>
      </div>
      <div class="folio-actions">
        <a href="/projects" class="section-link">Open <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Writing</h2>
      </div>
      <div class="folio-copy">
        <p>Essays on marketing, storytelling, and building your way in.</p>
      </div>
      <div class="folio-actions">
        <a href="/writing" class="section-link">Read <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Stack</h2>
      </div>
      <div class="folio-copy">
        <p>The tools and setup I use for work, research, and everyday life.</p>
      </div>
      <div class="folio-actions">
        <a href="/stack" class="section-link">Browse <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Speaking</h2>
      </div>
      <div class="folio-copy">
        <p>Selected conversations on governance, marketing, and narrative.</p>
      </div>
      <div class="folio-actions">
        <a href="/speaking" class="section-link">Watch <span class="arrow">→</span></a>
      </div>
    </article>

    <article class="folio-row folio-row--minor">
      <div class="folio-label">
        <h2>Now</h2>
      </div>
      <div class="folio-copy">
        <p>What I’m working on and paying attention to right now.</p>
      </div>
      <div class="folio-actions">
        <a href="/now" class="section-link">Current <span class="arrow">→</span></a>
      </div>
    </article>
  </section>
</Layout>

<style>
  .header {
    margin-bottom: 4rem;
  }

  .header-panel {
    padding-bottom: 1.3rem;
    border-bottom: 1px solid var(--line);
  }

  .header-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 176px;
    gap: 1.4rem;
    align-items: start;
  }

  .header-main {
    min-width: 0;
  }

  .header-top {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .header-copy {
    min-width: 0;
  }

  .portrait-panel {
    margin: 0;
  }

  .avatar {
    width: 136px;
    height: 136px;
    flex-shrink: 0;
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--line);
    transition: transform 180ms var(--ease-out);
  }

  .avatar--editorial {
    width: 176px;
    height: 216px;
    border-radius: 0;
    background: #d9d3c8;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .avatar--editorial img {
    filter: saturate(0.9) contrast(1.02);
  }

  .name {
    font-size: clamp(3.2rem, 8vw, 5.1rem);
    font-weight: 500;
    color: var(--text);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .bio {
    font-size: 1rem;
    color: var(--text-soft);
    margin-bottom: 1.15rem;
    line-height: 1.68;
    max-width: 25rem;
  }

  .contact-strip {
    display: flex;
    align-items: center;
    gap: 1rem 1.1rem;
    flex-wrap: wrap;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .contact-kicker {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-right: 0.1rem;
  }

  .contact-strip a {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .social-link-btn {
    font-family: var(--font-mono);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--text-faint);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color 150ms var(--ease-out),
      transform 140ms var(--ease-out);
    position: relative;
  }

  .social-link-btn:active {
    transform: scale(0.97);
  }

  .copy-toast {
    font-family: var(--font-mono);
    position: absolute;
    bottom: -1.6rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.56rem;
    color: #f6f2eb;
    background: rgba(24, 21, 19, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 0.16rem 0.38rem;
    border-radius: 999px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms var(--ease-out);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .social-link-btn.copied .copy-toast {
    opacity: 1;
  }

  .editorial-index {
    border-top: 1px solid var(--line);
  }

  .folio-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) auto;
    gap: 1.4rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

  .folio-label h2 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .folio-row--feature {
    padding-top: 1.45rem;
    padding-bottom: 1.3rem;
  }

  .folio-row--feature .folio-copy p {
    max-width: 31rem;
    font-size: 0.98rem;
    color: var(--text-soft);
    line-height: 1.58;
  }

  .folio-row--minor .folio-copy p {
    max-width: 30rem;
    font-size: 0.89rem;
    line-height: 1.52;
    color: var(--text-soft);
  }

  .folio-row--minor .folio-actions {
    padding-top: 0.05rem;
  }

  .folio-copy span {
    color: var(--text);
    font-style: italic;
  }

  .folio-copy .accent-callout {
    color: var(--accent);
    font-style: normal;
  }

  .folio-credits {
    font-family: var(--font-mono);
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.2rem;
    margin-top: 0.6rem;
    color: var(--text-faint);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .folio-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .section-link {
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-top: 0;
    font-size: 0.68rem;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-decoration: none;
    transition:
      color 150ms var(--ease-out),
      gap 160ms var(--ease-out);
  }

  .folio-row--feature .section-link {
    color: var(--text);
  }

  .section-link .arrow {
    display: inline-block;
    opacity: 0.8;
    transition: transform 160ms var(--ease-out);
  }

  .section-link--secondary {
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .header-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .portrait-panel {
      max-width: 176px;
    }

    .header {
      margin-bottom: 3.35rem;
    }

    .folio-row {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .folio-actions {
      align-items: flex-start;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .avatar:hover {
      transform: translateY(-1px) scale(1.01);
    }

    .contact-strip a:hover,
    .social-link-btn:hover {
      color: var(--accent);
      transform: translateY(-1px);
    }

    .section-link:hover {
      color: var(--text);
      gap: 0.45rem;
    }

    .section-link:hover .arrow {
      transform: translateX(2px);
    }

    .section-link--secondary:hover {
      color: var(--text);
    }
  }
</style>

<script>
  const copyBtn = document.querySelector('[data-copy]');
  copyBtn?.addEventListener('click', async () => {
    const text = copyBtn.getAttribute('data-copy');
    if (text) {
      await navigator.clipboard.writeText(text);
      copyBtn.classList.add('copied');
      setTimeout(() => copyBtn.classList.remove('copied'), 1500);
    }
  });
</script>
