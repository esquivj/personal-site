---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Speaking - Juan Esquivel',
  url: 'https://juanesquivel.xyz/speaking',
  description:
    'Podcasts, interviews, and talks by Juan Esquivel on crypto marketing, DAO governance, and brand building.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};
---

<Layout
  title="Speaking — Podcasts & Talks by Juan Esquivel"
  description="Podcasts, interviews, and speaking appearances by Juan Esquivel covering crypto marketing, DAO governance, brand building, and storytelling in web3."
  canonicalPath="/speaking"
  preloadImages={['/images/dao-talk-thumbnail.jpg']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="speaking" />

  <PageHeader title="Speaking" subtitle="Podcasts, interviews, and talks." />

  <section>
    <div class="surface-list">
      <a
        href="https://youtu.be/CYTEW2VF4n8"
        target="_blank"
        rel="noopener"
        class="surface-link surface-link--speaking"
      >
        <div class="surface-media surface-media--wide">
          <img
            src="/images/dao-talk-thumbnail.jpg"
            alt="DAO Talk thumbnail"
            width="120"
            height="68"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <div class="surface-body">
          <span class="surface-title">Governance Solution Providers & DAO Marketing</span>
          <span class="surface-meta">DAO Talk by Tally</span>
        </div>
        <span class="surface-arrow">Watch ↗</span>
      </a>
    </div>
  </section>
</Layout>

<style>
</style>
