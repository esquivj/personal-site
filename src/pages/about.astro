---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Juan Esquivel',
  url: 'https://juanesquivel.xyz/about',
  description:
    'Juan Esquivel is a marketing generalist from Los Angeles, a crypto native building with AI. Previously at Compound Foundation and StableLab.',
  mainEntity: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
    jobTitle: 'Marketing generalist',
  },
};
---

<Layout
  title="About Juan Esquivel — Crypto Marketer in Los Angeles"
  description="Juan Esquivel is a marketing generalist from Los Angeles, a crypto native building with AI. Previously at Compound Foundation and StableLab."
  canonicalPath="/about"
  preloadImages={['/images/about/about-stage.avif']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="about" />

  <div class="about-layout">
    <figure class="about-portrait">
      <img src="/images/about/about-stage.avif" alt="" width="528" height="576" loading="eager" decoding="async" fetchpriority="high" />
    </figure>

    <article class="about-essay">
      <h1 class="about-lead">I'm Juan. From Los Angeles, son of Mexican immigrants, <em>raised by the internet.</em></h1>

      <p>
        Most recently, I was the founding Socials and Community Lead at Compound Foundation. Before
        that, I spent three years leading marketing at StableLab. Right now: a crypto native building with AI.
      </p>

      <p>
        I studied finance and graduated around DeFi summer. After seeing what 2008 did to my family,
        a career in traditional finance wasn't especially appealing. Crypto's chaotic, bubbling tech
        culture felt more interesting. I broke in through writing and content.
      </p>

      <p>
        Over time, the work widened into brand, product, and narrative. Writing is still the part I
        enjoy the most, especially when a product is difficult to explain. The goal is to make the story
        clear enough that people want to keep paying attention. I like the part of marketing that
        feels close to design, where the details matter and judgment shows up in the work.
      </p>

      <blockquote class="about-quote">
        <p class="about-quote-line">Build your way in.</p>
        <p class="about-quote-body">I'm a generalist by nature. That's how I approach it: make things, put them out, and let the right people react.</p>
      </blockquote>

      <p>
        Outside work, I like traveling, watching films, finding music, following the Dodgers, and
        exploring whatever city I'm in. In another life, I ran marketing and ops for a London-based
        electronic music label and tried my hand at DJing. Everything bleeds into the work sooner or later.
      </p>

      <a href="/resume" target="_blank" rel="noopener" class="about-resume">View my resume <span aria-hidden="true">→</span></a>
    </article>
  </div>
</Layout>

<style>
  .about-layout {
    position: relative;
    left: 50%;
    width: min(1120px, calc(100vw - 4rem));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .about-portrait {
    position: sticky;
    top: 2rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--line);
    filter: saturate(0.82) contrast(1.03);
  }

  .about-portrait figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .about-essay {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .about-lead {
    font-size: clamp(2.3rem, 4.4vw, 3rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .about-lead em {
    color: var(--text-faint);
  }

  .about-essay > p {
    color: var(--text-soft);
    font-size: 1.05rem;
    line-height: 1.78;
  }

  .about-quote {
    position: relative;
    margin: 0.75rem 0;
    padding: 1.35rem 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .about-quote::before {
    content: '';
    position: absolute;
    left: 0;
    top: -4px;
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  .about-quote-line {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 5vw, 3.5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    color: var(--text);
  }

  .about-quote-body {
    margin-top: 0.6rem;
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .about-resume {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about-resume span {
    display: inline-block;
    color: var(--accent);
    transition: transform 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .about-resume:hover span {
      transform: translateX(3px);
    }
  }

  @media (max-width: 860px) {
    .about-layout {
      width: 100%;
      left: 0;
      transform: none;
      grid-template-columns: 1fr;
    }

    .about-portrait {
      position: static;
      max-width: 420px;
    }
  }
</style>
