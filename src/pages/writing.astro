---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { postsNewestFirst } from '../data/writing';

const preloadImages: string[] = [];

// Group essays by month, newest first.
const monthFormat = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const groups = postsNewestFirst.reduce<{ label: string; posts: typeof postsNewestFirst }[]>((acc, post) => {
  const label = monthFormat.format(new Date(`${post.publishedTime}T12:00:00Z`));
  const last = acc.at(-1);
  if (last?.label === label) last.posts.push(post);
  else acc.push({ label, posts: [post] });
  return acc;
}, []);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Writing by Juan Esquivel',
  url: 'https://juanesquivel.xyz/writing',
  description:
    'Essays on marketing, storytelling, and building your way in.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

---

<Layout
  title="Writing — Crypto Marketing Essays"
  description="Essays on marketing, storytelling, and building your way in."
  canonicalPath="/writing"
  preloadImages={preloadImages}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="writing" />

  <header class="writing-header">
    <h1 class="writing-title">Writing</h1>
    <p class="writing-subtitle">Essays on marketing, storytelling, and building your way in.</p>
  </header>

  {
    groups.map((group) => (
      <section class="writing-month" aria-label={group.label}>
        <h2 class="writing-month-label">{group.label}</h2>
        <ol class="writing-list">
          {group.posts.map((post) => (
            <li>
              <a href={`/writing/${post.slug}`} class="writing-row">
                <time class="writing-day" datetime={post.publishedTime}>{post.date.slice(5)}</time>
                <span class="writing-text">
                  <span class="writing-row-title">{post.title}</span>
                  <span class="writing-row-subtitle">{post.subtitle}</span>
                </span>
                <span class="writing-meta">
                  {post.readingTime ? post.readingTime.replace(/^RT:\s*/i, '') : 'Read'} <span class="writing-arrow" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Layout>

<style>
  .writing-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .writing-title {
    font-size: clamp(4rem, 12vw, 7.5rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .writing-subtitle {
    max-width: 32ch;
    color: var(--text-soft);
    line-height: 1.7;
  }

  .writing-month {
    margin-bottom: 2.5rem;
  }

  .writing-month-label {
    margin: 0 !important;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .writing-list {
    list-style: none;
  }

  .writing-row {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.4rem 1.75rem;
    padding: 1.6rem 0 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .writing-day,
  .writing-meta {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .writing-meta {
    text-transform: uppercase;
    white-space: nowrap;
  }

  .writing-arrow {
    color: var(--accent);
    display: inline-block;
    transition: transform 160ms var(--ease-out);
  }

  .writing-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .writing-row-title {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4.4vw, 2.9rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--text);
    text-wrap: balance;
    transition: color 150ms var(--ease-out);
  }

  .writing-row-subtitle {
    max-width: 60ch;
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (hover: hover) and (pointer: fine) {
    .writing-row:hover .writing-row-title {
      color: var(--accent);
    }

    .writing-row:hover .writing-arrow {
      transform: translateX(3px);
    }
  }

  @media (max-width: 640px) {
    .writing-row {
      grid-template-columns: 1fr;
    }

    .writing-meta {
      display: none;
    }
  }
</style>
