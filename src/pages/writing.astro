---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import { postsNewestFirst } from '../data/writing';

const preloadImages = postsNewestFirst.slice(0, 3).map((post) => post.cover);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Writing by Juan Esquivel',
  url: 'https://juanesquivel.xyz/writing',
  description:
    'Essays on marketing, storytelling, and building your way in.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

---

<Layout
  title="Writing — Crypto Marketing Essays"
  description="Essays on marketing, storytelling, and building your way in."
  canonicalPath="/writing"
  preloadImages={preloadImages}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="writing" />

  <PageHeader
    title="Writing"
    subtitle="Essays on marketing, storytelling, and building your way in."
  />

  <section class="posts">
    {
      postsNewestFirst.map((post) => (
        <a href={`/writing/${post.slug}`} class="post-card">
          <div class="post-card-cover">
            <img
              src={post.cover}
              alt={post.title}
              width="640"
              height="360"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="post-card-content">
            <p class="post-card-kicker">Essay</p>
            <h2 class="post-card-title">{post.title}</h2>
            <p class="post-card-subtitle">{post.subtitle}</p>
            <time class="post-card-date">{post.date}</time>
          </div>
        </a>
      ))
    }
  </section>
</Layout>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: grid;
    grid-template-columns: 184px minmax(0, 1fr);
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
    transition: background-color 180ms var(--ease-out);
  }

  .post-card:last-child {
    border-bottom: 1px solid var(--line);
  }

  .post-card:focus-visible {
    outline: 2px solid var(--line-strong);
    outline-offset: 4px;
  }

  .post-card-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 200ms var(--ease-out),
      filter 200ms var(--ease-out);
  }

  .post-card-content {
    padding: 0.1rem 0 0;
  }

  .post-card-kicker {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .post-card-title {
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 0.375rem;
    text-transform: none;
    letter-spacing: -0.02em;
    transition: color 150ms var(--ease-out);
  }

  .post-card-subtitle {
    font-size: 0.9375rem;
    color: var(--text-soft);
    line-height: 1.55;
    margin-bottom: 0.55rem;
    max-width: 38rem;
  }

  .post-card-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-card:hover {
      background: rgba(0, 0, 0, 0.015);
    }

    .post-card:hover .post-card-cover img {
      transform: scale(1.015);
      filter: brightness(1.05);
    }

    .post-card:hover .post-card-title {
      color: var(--accent);
    }
  }

  @media (max-width: 720px) {
    .post-card {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
