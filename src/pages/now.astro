---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const albums = [
  {
    "href": "https://open.spotify.com/album/0OAv7DCME2AV4q1KPO95HY",
    "src": "/images/listening/drake-iceman.jpg",
    "artist": "Drake",
    "title": "Iceman"
  },
  {
    "href": "https://open.spotify.com/album/5poA9SAx0Xiz1cf17fWBLS",
    "src": "/images/listening/kanye-bully.jpg",
    "artist": "Kanye West",
    "title": "Bully"
  },
  {
    "href": "https://open.spotify.com/album/4jI9SU1GmpIVhHMuYZuvX7",
    "src": "/images/listening/jcole-fall-off.jpg",
    "artist": "J Cole",
    "title": "The Fall Off"
  },
  {
    "href": "https://open.spotify.com/album/7MbDS0Fnw0buDkSjS1l4vd",
    "src": "/images/listening/chevelle-wonder-whats-next.jpg",
    "artist": "Chevelle",
    "title": "Wonder What's Next"
  },
  {
    "href": "https://open.spotify.com/album/2ANVost0y2y52ema1E9xAZ",
    "src": "/images/listening/deftones-private-music.jpg",
    "artist": "Deftones",
    "title": "private music"
  },
  {
    "href": "https://open.spotify.com/album/5LEXck3kfixFaA3CqVE7bC",
    "src": "/images/listening/deftones-white-pony.jpg",
    "artist": "Deftones",
    "title": "White Pony"
  },
  {
    "href": "https://open.spotify.com/album/4z7MXxGMbJOoYczjce8hQL",
    "src": "/images/listening/deftones-diamond-eyes.jpg",
    "artist": "Deftones",
    "title": "Diamond Eyes"
  },
  {
    "href": "https://open.spotify.com/album/2jkFEBmGBnpJEEMsCJBbMd",
    "src": "/images/listening/juniorh-sad-boyz.jpg",
    "artist": "Junior H",
    "title": "$AD BOYZ 4 LIFE II"
  },
  {
    "href": "https://open.spotify.com/album/2d9BCmHnVcnWfOWBdnFkq0",
    "src": "/images/listening/pesopluma-dinastia.jpg",
    "artist": "Peso Pluma",
    "title": "DINASTÍA"
  },
  {
    "href": "https://open.spotify.com/album/1lGnl3jV1fiujKBNhcH3yr",
    "src": "/images/listening/pesopluma-exodo.jpg",
    "artist": "Peso Pluma",
    "title": "ÉXODO"
  }
];
const books = [
  {
    "href": "https://www.penguinrandomhouse.com/books/717356/the-creative-act-by-rick-rubin/9780593652886/",
    "src": "/images/reading/the-creative-act.jpg",
    "author": "Rick Rubin",
    "title": "The Creative Act"
  },
  {
    "href": "https://www.penguinrandomhouse.com/books/318795/psycho-cybernetics-by-maxwell-maltz-md-fics/",
    "src": "/images/reading/psycho-cybernetics.jpg",
    "author": "Maxwell Maltz",
    "title": "Psycho-Cybernetics"
  },
  {
    "href": "https://press.stripe.com/poor-charlies-almanack",
    "src": "/images/reading/poor-charlies-almanack.jpg",
    "author": "Charles T. Munger",
    "title": "Poor Charlie's Almanack"
  }
];
const onRepeat = ['Iceman', 'White Pony', 'The Fall Off', 'ÉXODO'].map((title) => albums.find((album) => album.title === title)!);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'What Juan Esquivel is doing now',
  url: 'https://juanesquivel.xyz/now',
  description:
    'Work and interests from Juan Esquivel, a crypto native exploring AI in Los Angeles. Previously at Compound Foundation and StableLab.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};
---

<Layout
  title="Now — What Juan Esquivel is Working On"
  description="Work and interests from Juan Esquivel, a crypto native exploring AI in Los Angeles. Previously at Compound Foundation and StableLab."
  canonicalPath="/now"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="now" />

  <article class="now-letter">
    <p class="now-dateline"><span>Los Angeles</span><time datetime="2026-10-22">October 22, 2026</time></p>

    <h1 class="now-lede">Back in Los Angeles after living in Lisbon for a year and a half.</h1>

    <p>Re-settling into the city, spending more time with family, lifting consistently, and reading more.</p>

    <p>
      Most recently, I was the founding social lead at <a href="https://compound.xyz" target="_blank" rel="noopener" class="text-link">Compound Foundation</a>.
      Before that, three years leading marketing at StableLab across content, brand, product, and GTM.
      Frequently playing with agentic harnesses like Grok Bot, Muse, Instinct, and Hermes Agent.
    </p>

    <p>
      Listening to{' '}
      {onRepeat.map((album, i) => (
        <>
          <a href={album.href} target="_blank" rel="noopener" class="now-inline" title={`${album.artist}, ${album.title}`}>
            <img src={album.src} alt="" width="40" height="40" loading="lazy" decoding="async" class="now-cover now-cover--album" />
            <em>{album.title}</em></a>{i < onRepeat.length - 2 ? ', ' : i === onRepeat.length - 2 ? ', and ' : '.'}
        </>
      ))}{' '}
      The rest is on <a href="https://open.spotify.com/user/caveatt" target="_blank" rel="noopener" class="text-link">Spotify</a>.
    </p>

    <p>
      Reading{' '}
      {books.map((book, i) => (
        <>
          <a href={book.href} target="_blank" rel="noopener" class="now-inline" title={`${book.title} by ${book.author}`}>
            <img src={book.src} alt="" width="28" height="42" loading="lazy" decoding="async" class="now-cover now-cover--book" />
            <em>{book.title}</em></a>{i < books.length - 2 ? ', ' : i === books.length - 2 ? ', and ' : '.'}
        </>
      ))}
    </p>

    <p>
      Watching <a href="https://letterboxd.com/cadena/" target="_blank" rel="noopener" class="text-link"><em>The Deer Hunter</em>, <em>The Odyssey</em>, <em>One Battle After Another</em>, <em>Bugonia</em>, and <em>Weapons</em></a>.
      On TV, <em>Silo</em>, <em>Entourage</em>, <em>Pluribus</em>, and <em>IT: Welcome to Derry</em>.
    </p>

    <p>Following George Heaton, Kai Cenat, Agent00, Daniel Simmons, and Sam Sulek.</p>

    <p class="now-signoff">Juan</p>

    <p class="now-note">Updated October 22, 2026. Creators last updated April 2026.</p>
  </article>
</Layout>

<style>
  .now-letter {
    max-width: 640px;
    margin: 1.5rem auto 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    line-height: 1.5;
    color: #2f2c28;
  }

  .now-letter p {
    margin-bottom: 1.5rem;
  }

  .now-dateline {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem !important;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .now-lede {
    margin-bottom: 1.75rem;
    font-size: clamp(2rem, 4.6vw, 2.5rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .now-inline {
    white-space: nowrap;
  }

  .now-cover {
    display: inline-block;
    object-fit: cover;
    margin: 0 0.2em 0 0.1em;
    vertical-align: -0.2em;
  }

  .now-cover--album {
    width: 1.1em;
    height: 1.1em;
  }

  .now-cover--book {
    width: 0.8em;
    height: 1.2em;
    vertical-align: -0.24em;
  }

  .now-signoff {
    margin-top: 2.5rem;
    font-style: italic;
    font-size: 2.1rem;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .now-note {
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
</style>
