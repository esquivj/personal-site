---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'What Juan Esquivel is doing now',
  url: 'https://juanesquivel.xyz/now',
  description:
    'What Juan Esquivel is currently focused on - work, projects, life in Los Angeles, and current interests.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};
---

<Layout
  title="Now — What Juan Esquivel is Working On"
  description="What Juan Esquivel is currently focused on - exploring new opportunities, building a personal brand, life in Los Angeles, and current interests."
  canonicalPath="/now"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="now" />

  <PageHeader title="Now" subtitle="What I'm focused on at the moment." />

  <div class="now-ledger">
    <section class="now-row">
      <h2>Work</h2>
      <div class="now-row-body">
        <p>
          Recently wrapped up three years leading marketing at StableLab. Now exploring what's next.
          Still thinking about how to tell stories that actually land in crypto.
        </p>
      </div>
    </section>

    <section class="now-row">
      <h2>Building</h2>
      <div class="now-row-body">
        <p>
          Building a personal brand. Trying to connect with people who think about this stuff the same
          way I do and inspiring people in crypto to care about storytelling.
        </p>
      </div>
    </section>

    <section class="now-row">
      <h2>Life</h2>
      <div class="now-row-body">
        <p>
          Back in Los Angeles. Re-settling into the city, spending more time with family, lifting
          consistently, and trying to read and cook more.
        </p>
      </div>
    </section>

    <section class="now-row">
      <h2>Listening</h2>
      <div class="now-row-body">
        <a href="https://open.spotify.com/user/caveatt" target="_blank" rel="noopener" class="inline-link"
          >Deftones, Junior H, Peso Pluma ↗</a
        >
      </div>
    </section>

    <section class="now-row now-row--watching">
      <h2>Watching</h2>
      <div class="now-row-body">
        <div class="watching-block">
          <h3>Movies</h3>
          <a href="https://letterboxd.com/cadena/" target="_blank" rel="noopener" class="inline-link"
            >One Battle After Another, Bugonia, Weapons ↗</a
          >
        </div>

        <div class="watching-block">
          <h3>Shows</h3>
          <p class="watching-text">Entourage, Pluribus, IT: Welcome to Derry</p>
        </div>

        <div class="watching-block">
          <h3>Creators</h3>
          <p class="watching-text">George Heaton, Kai Cenat, Agent00, Daniel Simmons, Sam Sulek</p>
        </div>
      </div>
    </section>
  </div>

  <p class="page-note">Last updated: April 2026</p>
</Layout>

<style>
  .now-ledger {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .now-row {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.35rem 0;
    margin-bottom: 0;
    border-bottom: 1px solid var(--line);
  }

  .now-row h2 {
    margin-bottom: 0;
  }

  .now-row-body {
    min-width: 0;
  }

  .now-row p {
    color: var(--text-soft);
    max-width: 62ch;
    font-size: 1rem;
    line-height: 1.82;
  }

  .watching-block + .watching-block {
    margin-top: 1.5rem;
  }

  .watching-block h3 {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--text-soft);
    margin-bottom: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .watching-text,
  .inline-link {
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.82;
  }

  .inline-link:hover {
    color: var(--accent);
  }

  .page-note {
    margin-top: 3rem;
  }

  @media (max-width: 700px) {
    .now-row {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
