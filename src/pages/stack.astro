---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import UiIcon from '../components/UiIcon.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Juan Esquivel's Stack",
  url: 'https://juanesquivel.xyz/stack',
  description:
    'Tools, apps, and gear that Juan Esquivel uses daily for development, productivity, and creativity.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

const favorites = [
  {
    name: 'Claude Code',
    role: 'Thinking + shipping',
    href: 'https://claude.ai/code',
    icon: '/images/stack/anthropic.jpg',
  },
  {
    name: 'Cursor',
    role: 'Editor',
    href: 'https://cursor.com',
    icon: '/images/stack/cursor.png',
  },
  {
    name: 'Obsidian',
    role: 'Notes + ideas',
    href: 'https://obsidian.md',
    icon: '/images/stack/obsidian.jpg',
  },
  {
    name: 'Dia',
    role: 'Research',
    href: 'https://www.diabrowser.com',
    icon: '/images/stack/dia.png',
  },
];

const stackSections = [
  {
    title: 'Development',
    intro: 'The tools I keep open while building, shipping, and debugging.',
    items: [
      {
        name: 'Claude Code',
        desc: 'AI coding assistant',
        href: 'https://claude.ai/code',
        icon: '/images/stack/anthropic.jpg',
        note: 'Primary thinking partner',
        featured: true,
      },
      {
        name: 'Cursor',
        desc: 'AI-powered code editor',
        href: 'https://cursor.com',
        icon: '/images/stack/cursor.png',
        note: 'Primary editor',
      },
      {
        name: 'Ghostty',
        desc: 'Terminal emulator',
        href: 'https://ghostty.org',
        icon: '/images/stack/ghostty.png',
        note: 'Fast and clean',
      },
      {
        name: 'OpenClaw',
        desc: 'AI computer use agent',
        href: 'https://openclaw.ai',
        icon: '/images/stack/openclaw.jpg',
        note: 'Experimental workflow',
      },
    ],
  },
  {
    title: 'Productivity',
    intro: 'Where projects, notes, time, and meetings stay in motion.',
    items: [
      {
        name: 'Obsidian',
        desc: 'Knowledge management',
        href: 'https://obsidian.md',
        icon: '/images/stack/obsidian.jpg',
        note: 'Second brain',
        featured: true,
      },
      {
        name: 'Notion',
        desc: 'Docs and wikis',
        href: 'https://notion.so',
        icon: '/images/stack/notion.png',
      },
      {
        name: 'Linear',
        desc: 'Project and task management',
        href: 'https://linear.app',
        icon: '/images/stack/linear.jpg',
      },
      {
        name: 'Amie',
        desc: 'Calendar',
        href: 'https://amie.so',
        icon: '/images/stack/amie.jpg',
      },
      {
        name: 'Granola',
        desc: 'AI meeting notes',
        href: 'https://granola.ai',
        icon: '/images/stack/granola.png',
      },
      {
        name: 'Things 3',
        desc: 'Task management',
        href: 'https://culturedcode.com/things/',
        icon: '/images/stack/things.jpg',
      },
    ],
  },
  {
    title: 'Research & Browsing',
    intro: 'The tools I use to collect references, wander, and actually find signal.',
    items: [
      {
        name: 'Dia',
        desc: 'Web browser',
        href: 'https://www.diabrowser.com',
        icon: '/images/stack/dia.png',
        note: 'Default browser',
        featured: true,
      },
      {
        name: 'Eagle',
        desc: 'Image and video library',
        href: 'https://eagle.cool',
        icon: '/images/stack/eagle.jpg',
        note: 'Reference archive',
      },
    ],
  },
  {
    title: 'Communication',
    intro: 'Messaging and email without letting either take over the day.',
    items: [
      {
        name: 'Beeper',
        desc: 'All-in-one messaging',
        href: 'https://www.beeper.com',
        icon: '/images/stack/beeper.png',
        note: 'Inbox for everything',
        featured: true,
      },
      {
        name: 'Notion Mail',
        desc: 'Email client',
        href: 'https://notion.so/product/mail',
        icon: '/images/stack/notion.png',
        note: 'Current email setup',
      },
    ],
  },
  {
    title: 'Music',
    intro: 'The background layer.',
    items: [
      {
        name: 'Spotify',
        desc: 'Music streaming',
        href: 'https://spotify.com',
        icon: '/images/stack/spotify.png',
        note: 'Always on',
        featured: true,
      },
    ],
  },
];

const totalTools = stackSections.reduce((count, section) => count + section.items.length, 0);
---

<Layout
  title="Stack — Tools & Apps Used by Juan Esquivel"
  description="Tools, apps, and gear that power Juan Esquivel's day-to-day. Development tools, productivity apps, and creative software."
  canonicalPath="/stack"
  preloadImages={['/images/stack/anthropic.jpg', '/images/stack/cursor.png', '/images/stack/ghostty.png']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="stack" />

  <PageHeader title="Stack" subtitle="The software I actually like using day to day." />

  <section class="stack-stage stack-breakout">
    <div class="stack-stage-copy">
      <p class="stack-stage-kicker"><UiIcon name="apps" size={14} class="stack-kicker-icon" />Current daily drivers</p>
      <p class="stack-stage-text">
        The software I keep open more than anything else. Less a catalog, more the tools I trust
        to write, build, research, and run the day.
      </p>
      <div class="stack-stage-meta">
        <span>{favorites.length} daily</span>
        <span>{totalTools} in rotation</span>
        <span>{stackSections.length} shelves</span>
      </div>
    </div>

    <div class="stack-stage-board">
      {favorites.map((item, index) => (
        <a
          href={item.href}
          target="_blank"
          rel="noopener"
          class:list={['stack-atlas-card', `stack-atlas-card--${index + 1}`]}
        >
          <span class="stack-atlas-index">{String(index + 1).padStart(2, '0')}</span>
          <div class="stack-atlas-media">
            <img src={item.icon} alt={item.name} width="72" height="72" loading="lazy" decoding="async" class="contain" />
          </div>
          <div class="stack-atlas-body">
            <span class="stack-atlas-name">{item.name}</span>
            <span class="stack-atlas-role">{item.role}</span>
          </div>
          <UiIcon name="arrow-up-right" size={16} class="stack-atlas-arrow" />
        </a>
      ))}
    </div>
  </section>

  {
    stackSections.map((section, sectionIndex) => (
      <section class="stack-shelf stack-breakout">
        <div class="stack-section-head">
          <span class="stack-section-kicker">{String(sectionIndex + 1).padStart(2, '0')}</span>
          <h2>{section.title}</h2>
          <p>{section.intro}</p>
        </div>

        <div class="stack-grid">
          {section.items.map((item, itemIndex) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              class:list={['stack-card', item.featured && 'stack-card--featured']}
            >
              <span class="stack-card-index">{String(itemIndex + 1).padStart(2, '0')}</span>
              <div class="stack-card-media">
                <img src={item.icon} alt={item.name} width="60" height="60" loading="lazy" decoding="async" class="contain" />
              </div>
              <div class="stack-card-body">
                <span class="stack-card-name">{item.name}</span>
                <span class="stack-card-desc">{item.desc}</span>
                {item.note && <span class="stack-card-note">{item.note}</span>}
              </div>
              <UiIcon name="arrow-up-right" size={14} class="stack-card-arrow" />
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <p class="page-note stack-note">Hardware, gear, and everyday carry are next.</p>
</Layout>

<style>
  .stack-breakout {
    position: relative;
    left: 50%;
    width: min(1080px, calc(100vw - 4rem));
    transform: translateX(-50%);
  }

  .stack-stage {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 2.2rem;
    align-items: start;
    padding: 0 0 2.45rem;
    border-bottom: 1px solid var(--line);
  }

  .stack-stage-copy {
    max-width: 15.5rem;
    padding-top: 0.3rem;
  }

  .stack-stage-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--text-faint);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .stack-stage-text {
    max-width: 22ch;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.72;
  }

  .stack-stage-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--text-faint);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stack-stage-board {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(118px, auto);
    gap: 0.95rem;
    padding: 1.15rem;
    border: 1px solid var(--line);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.42), rgba(20, 19, 17, 0.025)),
      linear-gradient(90deg, rgba(20, 19, 17, 0.02), rgba(20, 19, 17, 0));
    overflow: hidden;
  }

  .stack-stage-board::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(20, 19, 17, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(20, 19, 17, 0.04) 1px, transparent 1px);
    background-size: 100% 100%, calc(25% - 0.05rem) 100%;
    opacity: 0.2;
    pointer-events: none;
  }

  .stack-stage-board::after {
    content: 'Desk';
    position: absolute;
    right: 1rem;
    bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: rgba(20, 19, 17, 0.36);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .stack-atlas-card {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: start;
    padding: 1rem;
    border: 1px solid rgba(20, 19, 17, 0.1);
    background: rgba(249, 247, 243, 0.8);
    box-shadow: 0 16px 28px rgba(20, 19, 17, 0.03);
    transition:
      transform 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out),
      background 180ms var(--ease-out);
  }

  .stack-atlas-card--1 {
    grid-column: span 2;
    grid-row: span 2;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    padding: 1.25rem;
    box-shadow:
      inset 0 2px 0 var(--accent),
      0 18px 34px rgba(20, 19, 17, 0.05);
  }

  .stack-atlas-card--4 {
    grid-column: span 2;
  }

  .stack-atlas-index,
  .stack-card-index {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.54rem;
    color: rgba(20, 19, 17, 0.42);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack-atlas-media,
  .stack-card-media {
    width: 56px;
    height: 56px;
    border: 1px solid rgba(20, 19, 17, 0.1);
    background: rgba(20, 19, 17, 0.04);
    overflow: hidden;
  }

  .stack-atlas-card--1 .stack-atlas-media {
    width: 72px;
    height: 72px;
  }

  .stack-atlas-media img,
  .stack-card-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .stack-atlas-media img.contain,
  .stack-card-media img.contain {
    object-fit: contain;
    padding: 0.2rem;
  }

  .stack-atlas-name,
  .stack-card-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  .stack-atlas-card--1 .stack-atlas-name,
  .stack-card--featured .stack-card-name {
    font-size: clamp(1.55rem, 2vw, 1.9rem);
  }

  .stack-atlas-role,
  .stack-card-note {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    color: var(--text-faint);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stack-atlas-arrow,
  .stack-card-arrow,
  .stack-kicker-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .stack-atlas-arrow,
  .stack-card-arrow {
    color: var(--text-faint);
    transition: transform 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  .stack-shelf {
    display: grid;
    grid-template-columns: 158px minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .stack-shelf + .stack-shelf {
    margin-top: 2.5rem;
  }

  .stack-section-head {
    max-width: 14rem;
  }

  .stack-section-kicker {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    color: var(--text-faint);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack-section-head h2 {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stack-section-head p {
    margin-top: 0.7rem;
    max-width: 18ch;
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.72;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .stack-grid > :only-child {
    grid-column: 1 / -1;
  }

  .stack-card {
    position: relative;
    grid-column: span 4;
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: start;
    min-height: 7.2rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.34), rgba(20, 19, 17, 0.02));
    transition:
      transform 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      background 180ms var(--ease-out),
      box-shadow 180ms var(--ease-out);
  }

  .stack-card--featured {
    grid-column: span 8;
    min-height: 8.4rem;
    padding: 1.1rem 1.1rem 1.15rem;
    box-shadow: inset 0 2px 0 var(--accent);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.46), rgba(20, 19, 17, 0.03));
  }

  .stack-card-body {
    min-width: 0;
  }

  .stack-card-desc {
    display: block;
    margin-top: 0.34rem;
    color: var(--text-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .stack-card-note {
    color: var(--accent);
  }

  .stack-note {
    width: min(1080px, calc(100vw - 4rem));
    margin-top: 2.85rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .stack-atlas-card:hover,
    .stack-card:hover {
      transform: translateY(-2px);
      border-color: var(--line-strong);
      box-shadow: 0 20px 34px rgba(20, 19, 17, 0.06);
      background: rgba(249, 247, 243, 0.98);
    }

    .stack-atlas-card:hover .stack-atlas-arrow,
    .stack-card:hover .stack-card-arrow {
      transform: translate(2px, -2px);
      color: var(--text);
    }
  }

  @media (max-width: 960px) {
    .stack-breakout,
    .stack-note {
      left: auto;
      width: auto;
      transform: none;
    }

    .stack-stage {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .stack-stage-copy {
      max-width: 34rem;
    }

    .stack-stage-text {
      max-width: 36ch;
    }

    .stack-shelf {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .stack-section-head {
      max-width: 34rem;
    }

    .stack-section-head p {
      max-width: 34ch;
    }
  }

  @media (max-width: 760px) {
    .stack-stage-board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stack-atlas-card--1,
    .stack-atlas-card--4 {
      grid-column: span 2;
    }

    .stack-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .stack-card {
      grid-column: span 3;
    }

    .stack-card--featured,
    .stack-grid > :only-child {
      grid-column: span 6;
    }
  }

  @media (max-width: 560px) {
    .stack-stage-board {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .stack-atlas-card,
    .stack-atlas-card--1,
    .stack-atlas-card--4 {
      grid-column: span 1;
      grid-row: span 1;
      grid-template-columns: 56px minmax(0, 1fr) auto;
      padding: 0.9rem;
    }

    .stack-atlas-card--1 .stack-atlas-media {
      width: 56px;
      height: 56px;
    }

    .stack-grid {
      grid-template-columns: 1fr;
    }

    .stack-card,
    .stack-card--featured,
    .stack-grid > :only-child {
      grid-column: span 1;
      min-height: 0;
    }

    .stack-card {
      grid-template-columns: 52px minmax(0, 1fr) auto;
      gap: 0.75rem;
      padding: 0.9rem;
    }

    .stack-atlas-index,
    .stack-card-index {
      display: none;
    }

    .stack-atlas-name,
    .stack-card-name,
    .stack-card--featured .stack-card-name,
    .stack-atlas-card--1 .stack-atlas-name {
      font-size: 1.15rem;
    }
  }
</style>
