const totalTools = stackSections.reduce((count, section) => count + section.items.length, 0);

// Mirrors the Dock on my Mac, left to right.
type DockItem = { name: string; icon: string; category: string; desc: string; note?: string; href?: string; badge?: string; dial?: boolean; live?: boolean };
const dock: DockItem[] = [
  { name: 'Dia', icon: '/images/stack/mac/dia.webp', category: 'Research & Browsing', desc: 'Web browser', note: 'Default browser', href: 'https://www.diabrowser.com' },
  { name: 'Obsidian', icon: '/images/stack/mac/obsidian.webp', category: 'Productivity', desc: 'Knowledge management', note: 'Second brain', href: 'https://obsidian.md' },
  { name: 'Things 3', icon: '/images/stack/mac/things3.webp', category: 'Productivity', desc: 'Task management', note: 'Daily todos', href: 'https://culturedcode.com/things/' },
  { name: 'Grok Bot', icon: '/images/stack/mac/grok-bot.webp', category: 'AI & Agents', desc: 'AI agents', note: 'Where I built the Compound bots', href: 'https://x.ai/bot' },
  { name: 'Hermes Agent', icon: '/images/stack/mac/hermes.webp', category: 'AI & Agents', desc: 'Agent harness', note: 'Agent orchestration layer', href: 'https://github.com/NousResearch/hermes-agent' },
  { name: 'Linear', icon: '/images/stack/mac/linear.webp', category: 'Productivity', desc: 'Issue tracking', note: "Tracks what I'm building", href: 'https://linear.app' },
  { name: 'Cursor', icon: '/images/stack/mac/cursor.webp', category: 'Building', desc: 'Code editor', note: 'For hands-on edits', href: 'https://cursor.com' },
  { name: 'Claude', icon: '/images/stack/mac/claude.webp', category: 'AI & Agents', desc: 'AI assistant and Claude Code', note: 'Primary thinking partner', href: 'https://claude.ai' },
  { name: 'Beeper', icon: '/images/stack/mac/beeper-desktop.webp', category: 'Communication', desc: 'All-in-one messaging', note: 'Inbox for everything', href: 'https://www.beeper.com', badge: '19' },
  { name: 'Coindock', icon: ethTile(), category: 'Crypto', desc: 'Live ETH price in the dock', note: 'Markets at a glance', live: true },
  { name: 'Dial', icon: '/images/listening/drake-iceman.jpg', category: 'Built by me', desc: 'Now playing, remembered.', note: 'Icon shows the album playing', href: '/projects', dial: true },
];
const defaultPick = dock.findIndex((item) => item.name === 'Claude');
const picked = dock[defaultPick];

// Dial's icon shows whatever album is playing; cycle through what I'm listening to.
const dialCovers = [
  'drake-iceman', 'kanye-bully', 'jcole-fall-off', 'chevelle-wonder-whats-next', 'deftones-private-music',
  'deftones-white-pony', 'deftones-diamond-eyes', 'juniorh-sad-boyz', 'pesopluma-dinastia', 'pesopluma-exodo',
].map((name) => `/images/listening/${name}.jpg`);

// Everything else from the stack, grouped as before. Claude Code lives in the dock as Claude.
const inDock = new Set([...dock.map((item) => item.name), 'Claude Code']);
const shelves = stackSections
  .map((section) => ({ ...section, items: section.items.filter((item) => !inDock.has(item.name)) }))
  .filter((section) => section.items.length > 0);

---

<Layout
  title="Stack — Tools & Apps Used by Juan Esquivel"
  description="Tools, apps, and gear that power Juan Esquivel's day-to-day. AI tools and agents, productivity apps, and creative software."
  canonicalPath="/stack"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="stack" />

  <header class="stack-header">
    <h1 class="stack-title">Stack</h1>
    <p class="stack-subtitle">The software I actually like using day to day. This is my actual dock.</p>
  </header>

  <figure class="dock-figure" data-dock>
    <ul class="dock" aria-label="Apps in my dock">
      {dock.map((item, i) => (
        <li class="dock-slot">
          <button
            type="button"
            class="dock-item"
            aria-label={item.name}
            aria-pressed={i === defaultPick ? 'true' : 'false'}
            data-index={i}
            data-name={item.name}
            data-category={item.category}
            data-desc={item.desc}
            data-note={item.note ?? ''}
            data-href={item.href ?? ''}
            data-icon={item.icon}
          >
            <span class="dock-label" aria-hidden="true">{item.name}</span>
            <span class="dock-icon">
              <img
                src={item.icon}
                alt=""
                width="56"
                height="56"
                decoding="async"
                data-dial-cover={item.dial ? '' : undefined}
                data-eth-tile={item.live ? '' : undefined}
              />
              {item.badge && <span class="dock-badge" aria-hidden="true">{item.badge}</span>}
            </span>
            <span class="dock-dot" aria-hidden="true"></span>
          </button>
        </li>
      ))}
    </ul>
    <figcaption><span class="dock-hint-fine">Hover to magnify · click for the why</span><span class="dock-hint-touch">Tap an icon for the why</span></figcaption>
    <script type="application/json" data-dial-covers set:html={JSON.stringify(dialCovers)} />
  </figure>

  <section class="dock-detail" aria-live="polite" data-dock-detail>
    <img src={picked.icon} alt="" width="96" height="96" class:list={['dock-detail-icon', { 'is-cover': picked.dial }]} data-detail-icon />
    <div class="dock-detail-body">
      <span class="dock-detail-category" data-detail-category>{picked.category}</span>
      <span class="dock-detail-name" data-detail-name>{picked.name}</span>
      <span class="dock-detail-desc" data-detail-desc>{picked.desc}</span>
    </div>
    <div class="dock-detail-side">
      <span class="dock-detail-note" data-detail-note>{picked.note}</span>
      <a href={picked.href} target="_blank" rel="noopener" class="dock-detail-link" data-detail-link>Visit <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="stack-activity" aria-labelledby="ai-activity-title">
    <h2 class="stack-more-title" id="ai-activity-title">AI activity</h2>
    <p class="stack-activity-intro">Daily tokens across Claude and Codex.</p>
    <AIActivity />
  </section>

  <h2 class="stack-more-title">Also in rotation</h2>
  {shelves.map((section) => (
    <section class="stack-shelf">
      <div class="stack-shelf-head">
        <h3>{section.title}</h3>
        <p>{section.intro}</p>
      </div>
      <ul class="rotation-list">
        {section.items.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener" class="rotation-row">
              {item.icon ? (
                <img src={item.icon} alt="" width="28" height="28" loading="lazy" decoding="async" />
              ) : (
                <span class="rotation-monogram" aria-hidden="true">{item.name[0]}</span>
              )}
              <span class="rotation-text">
                <span class="rotation-name">{item.name}</span>
                <span class="rotation-desc">{item.desc}</span>
              </span>
              {item.note && <span class="rotation-note">{item.note}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<script>
  import { ethTile, formatEthPrice } from '../lib/eth-tile';

  const dockRoot = document.querySelector<HTMLElement>('[data-dock]');
  const detail = document.querySelector<HTMLElement>('[data-dock-detail]');
  if (dockRoot && detail) {
    const items = [...dockRoot.querySelectorAll<HTMLButtonElement>('.dock-item')];
    const icon = detail.querySelector<HTMLImageElement>('[data-detail-icon]')!;
    const category = detail.querySelector<HTMLElement>('[data-detail-category]')!;
    const name = detail.querySelector<HTMLElement>('[data-detail-name]')!;
    const desc = detail.querySelector<HTMLElement>('[data-detail-desc]')!;
    const note = detail.querySelector<HTMLElement>('[data-detail-note]')!;
    const link = detail.querySelector<HTMLAnchorElement>('[data-detail-link]')!;
    const dialCover = dockRoot.querySelector<HTMLImageElement>('[data-dial-cover]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    const show = (button: HTMLButtonElement) => {
      items.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      const d = button.dataset;
      const img = button.querySelector('img');
      icon.src = img?.src ?? d.icon ?? '';
      icon.classList.toggle('is-cover', d.name === 'Dial');
      category.textContent = d.category ?? '';
      name.textContent = d.name ?? '';
      desc.textContent = d.desc ?? '';
      note.textContent = d.note ?? '';
      link.hidden = !d.href;
      if (d.href) {
        link.href = d.href;
        const external = d.href.startsWith('http');
        link.target = external ? '_blank' : '';
        link.firstChild!.textContent = external ? 'Visit ' : 'See the project ';
      }
    };
    items.forEach((button) => button.addEventListener('click', () => show(button)));

    // Magnification: each icon's size follows the cursor's distance from its center
    // (cosine falloff), eased with a spring. Sizes change layout, so neighbors make room.
    const dockList = dockRoot.querySelector<HTMLElement>('.dock');
    const slots = [...dockRoot.querySelectorAll<HTMLElement>('.dock-slot')];
    const fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    let BASE = 56;
    let PEAK = 92;
    let REACH = 170;
    const state = slots.map(() => ({ size: BASE, velocity: 0 }));

    // Fit the resting icon size to the available width so the dock stays on one line.
    const fit = () => {
      if (!dockList) return;
      const available = (dockRoot.clientWidth || window.innerWidth) - 32;
      const gap = 8;
      BASE = fineHover.matches ? Math.max(34, Math.min(56, Math.floor((available - 24 - gap * (slots.length - 1)) / slots.length))) : 56;
      PEAK = Math.round(BASE * 1.65);
      REACH = BASE * 3;
      dockList.style.setProperty('--base', `${BASE}px`);
      state.forEach((s, i) => { s.size = BASE; s.velocity = 0; slots[i].style.removeProperty('--size'); });
    };
    fit();
    window.addEventListener('resize', fit);
    fineHover.addEventListener?.('change', fit);
    let pointerX: number | null = null;
    let frame = 0;
    let last = 0;

    const step = (now: number) => {
      const dt = Math.min(0.032, (now - (last || now)) / 1000) || 1 / 60;
      last = now;
      let moving = false;
      slots.forEach((slot, i) => {
        let target = BASE;
        if (pointerX !== null) {
          const box = slot.getBoundingClientRect();
          const d = Math.abs(pointerX - (box.left + box.width / 2));
          if (d < REACH) target = BASE + (PEAK - BASE) * (Math.cos((Math.PI * d) / REACH) + 1) / 2;
        }
        const s = state[i];
        if (reduced.matches) {
          // No spring when motion is reduced: sizes follow the cursor directly.
          s.size = target;
          s.velocity = 0;
        } else {
          // Damped spring toward the target size.
          const force = 320 * (target - s.size) - 28 * s.velocity;
          s.velocity += force * dt;
          s.size += s.velocity * dt;
        }
        if (Math.abs(target - s.size) > 0.05 || Math.abs(s.velocity) > 0.05) moving = true;
        else { s.size = target; s.velocity = 0; }
        slot.style.setProperty('--size', `${s.size.toFixed(2)}px`);
      });
      frame = moving || pointerX !== null ? requestAnimationFrame(step) : 0;
      if (!frame) last = 0;
    };
    const kick = () => { if (!frame) frame = requestAnimationFrame(step); };

    if (dockList) {
      dockList.addEventListener('pointermove', (event) => {
        if (event.pointerType === 'touch' || !fineHover.matches) return;
        pointerX = event.clientX;
        kick();
      });
      dockList.addEventListener('pointerleave', () => {
        pointerX = null;
        kick();
      });
    }

    // CoinDock's icon is the live ETH price; refresh it every minute while the page is open.
    const ethImg = dockRoot.querySelector<HTMLImageElement>('[data-eth-tile]');
    if (ethImg) {
      const refresh = async () => {
        try {
          const res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd');
          const usd = (await res.json())?.ethereum?.usd;
          if (typeof usd !== 'number') return;
          ethImg.src = ethTile(formatEthPrice(usd));
          ethImg.closest('button')?.setAttribute('title', `ETH $${formatEthPrice(usd)}`);
          if (ethImg.closest('[aria-pressed="true"]')) icon.src = ethImg.src;
        } catch {
          // Offline or rate limited: keep the last tile.
        }
      };
      refresh();
      setInterval(() => { if (!document.hidden) refresh(); }, 60_000);
    }

    // Dial's icon shows the album playing.
    const covers: string[] = JSON.parse(dockRoot.querySelector('[data-dial-covers]')?.textContent ?? '[]');
    if (dialCover && covers.length && !reduced.matches) {
      covers.forEach((src) => { const pre = new Image(); pre.src = src; });
      let n = 0;
      setInterval(() => {
        n = (n + 1) % covers.length;
        dialCover.src = covers[n];
        if (dialCover.closest('[aria-pressed="true"]')) icon.src = covers[n];
      }, 3500);
    }
  }
</script>

<style>
  .stack-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .stack-title {
    font-size: clamp(3rem, 7vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .stack-subtitle {
    color: var(--text-soft);
    line-height: 1.7;
  }

  .dock-figure {
    position: relative;
    left: 50%;
    width: min(1040px, calc(100vw - 2rem));
    transform: translateX(-50%);
    margin: 0 0 2.5rem;
    padding-top: 3.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .dock-hint-touch { display: none; }

  @media not ((hover: hover) and (pointer: fine)) {
    .dock-hint-fine { display: none; }
    .dock-hint-touch { display: inline; }
  }

  .dock-figure figcaption {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .dock {
    max-width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 0.5rem;
    min-height: calc(var(--base, 56px) + 18px);
    padding: 0.5rem 0.75rem 0.4rem;
    list-style: none;
    border-radius: 24px;
    background: rgba(24, 22, 24, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 60px rgba(18, 14, 10, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .dock-slot {
    --size: var(--base, 56px);
  }

  .dock-item {
    position: relative;
    width: var(--size);
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .dock-icon {
    position: relative;
    display: block;
    width: var(--size);
    height: var(--size);
  }

  .dock-icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Dial shows the album playing, so its cover gets the macOS icon shape and inset. */
  .dock-icon img[data-dial-cover] {
    width: 92%;
    height: 92%;
    margin: 4%;
    border-radius: 22.5%;
    object-fit: cover;
  }

  .dock-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: #e5483b;
    color: #fff;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    display: grid;
    place-items: center;
  }

  .dock-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgba(243, 241, 235, 0.45);
  }

  .dock-item[aria-pressed='true'] .dock-dot {
    background: #f3f1eb;
  }

  .dock-label {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(30, 28, 30, 0.92);
    color: #f3f1eb;
    font-family: var(--font-ui);
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms var(--ease-out);
    z-index: 2;
  }

  .dock-item:focus-visible {
    outline: none;
  }

  .dock-item:focus-visible .dock-icon img {
    outline: 2px solid #f3f1eb;
    outline-offset: 2px;
  }

  .dock-item:focus-visible .dock-label {
