};

const stackSections = [
  {
    title: 'AI & Agents',
    intro: "Consumer AI and agent harnesses I'm constantly playing with.",
    items: [
      {
        name: 'Grok Bot',
        desc: 'AI agents',
        href: 'https://x.ai/bot',
        icon: '/images/stack/grok-bot-app.png',
      },
      {
        name: 'Claude Code',
