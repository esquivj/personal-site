---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Juan Esquivel's Stack",
  url: 'https://juanesquivel.xyz/stack',
  description:
    'Tools, apps, and gear that Juan Esquivel uses daily for development, productivity, and creativity.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

const stackSections = [
  {
    title: 'AI & Agents',
    intro: "Consumer AI and agent harnesses I'm constantly playing with.",
    items: [
      {
        name: 'Grok Bot',
        desc: 'AI agents',
        href: 'https://x.ai/bot',
        icon: '/images/stack/grok-bot-app.png',
      },
      {
        name: 'Claude Code',
        desc: 'AI coding assistant',
        href: 'https://claude.ai/code',
        icon: '/images/stack/claude-code.png',
        note: 'Primary thinking partner',
      },
      {
        name: 'ChatGPT',
        desc: 'AI assistant',
        href: 'https://chatgpt.com',
        icon: '/images/stack/openai.png',
      },
      {
        name: 'Hermes Agent',
        desc: 'Agent harness',
        href: 'https://github.com/NousResearch/hermes-agent',
        icon: '/images/stack/hermes-light.png',
        note: 'Agent orchestration layer',
      },
      {
        name: 'Instinct',
        desc: 'Personal AI assistant',
        href: 'https://instinct.com',
        icon: '/images/stack/instinct.png',
      },
      {
        name: 'Muse',
        desc: 'Personal AI agent',
        href: 'https://muse.ai',
        icon: '/images/stack/muse.svg',
      },
    ],
  },
  {
    title: 'Productivity',
    intro: 'Where projects, notes, time, and meetings stay in motion.',
    items: [
      {
        name: 'Obsidian',
        desc: 'Knowledge management',
        href: 'https://obsidian.md',
        icon: '/images/stack/obsidian.png',
        note: 'Second brain',
      },
      {
        name: 'Notion',
        desc: 'Docs and wikis',
        href: 'https://notion.so',
        icon: '/images/stack/notion.png',
        note: 'Shared workspace',
      },
      {
        name: 'Granola',
        desc: 'AI meeting notes',
        href: 'https://granola.ai',
        icon: '/images/stack/granola.png',
        note: 'Auto-transcripts',
      },
      {
        name: 'Things 3',
        desc: 'Task management',
        href: 'https://culturedcode.com/things/',
        icon: '/images/stack/things.png',
        note: 'Daily todos',
      },
    ],
  },
  {
    title: 'Research & Browsing',
    intro: 'The tools I use to collect references, wander, and actually find signal.',
    items: [
      {
        name: 'Dia',
        desc: 'Web browser',
        href: 'https://www.diabrowser.com',
        icon: '/images/stack/dia.png',
        note: 'Default browser',
      },
      {
        name: 'DefiLlama',
        desc: 'DeFi analytics',
        href: 'https://defillama.com',
        icon: '/images/stack/defillama.png',
        note: 'TVL and flows',
      },
      {
        name: 'rwa.xyz',
        desc: 'RWA market data',
        href: 'https://rwa.xyz',
        icon: '/images/stack/rwaxyz.png',
        note: 'Tokenization figures',
      },
      {
        name: 'Token Terminal',
        desc: 'Onchain financial analytics',
        href: 'https://tokenterminal.com',
        icon: '/images/stack/tokenterminal.png',
        note: 'Revenue and fundamentals',
      },
      {
        name: 'Eagle',
        desc: 'Image and video library',
        href: 'https://eagle.cool',
        icon: '/images/stack/eagle.png',
        note: 'Reference archive',
      },
    ],
  },
  {
    title: 'Communication',
    intro: 'Messaging and email without letting either take over the day.',
    items: [
      {
        name: 'Beeper',
        desc: 'All-in-one messaging',
        href: 'https://www.beeper.com',
        icon: '/images/stack/beeper.png',
        note: 'Inbox for everything',
      },
      {
        name: 'Notion Mail',
        desc: 'Email client',
        href: 'https://notion.so/product/mail',
        icon: '/images/stack/notion.png',
        note: 'Current email setup',
      },
    ],
  },
  {
    title: 'Music',
    intro: 'The background layer.',
    items: [
      {
        name: 'Spotify',
        desc: 'Music streaming',
        href: 'https://spotify.com',
        icon: '/images/stack/spotify.png',
        note: 'Always on',
      },
    ],
  },
];

const totalTools = stackSections.reduce((count, section) => count + section.items.length, 0);

// Mirrors the Dock on my Mac, left to right.
type DockItem = { name: string; icon: string; category: string; desc: string; note?: string; href?: string; badge?: string; raw?: boolean; dial?: boolean };
const dock: DockItem[] = [
  { name: 'Finder', icon: '/images/stack/dock/finder.png', category: 'macOS', desc: 'File manager', note: 'Where the files live' },
  { name: 'Dia', icon: '/images/stack/dia.png', category: 'Research & Browsing', desc: 'Web browser', note: 'Default browser', href: 'https://www.diabrowser.com' },
  { name: 'Obsidian', icon: '/images/stack/obsidian.png', category: 'Productivity', desc: 'Knowledge management', note: 'Second brain', href: 'https://obsidian.md' },
  { name: 'Things 3', icon: '/images/stack/things.png', category: 'Productivity', desc: 'Task management', note: 'Daily todos', href: 'https://culturedcode.com/things/' },
  { name: 'Grok Bot', icon: '/images/stack/grok-bot-app.png', category: 'AI & Agents', desc: 'AI agents', note: 'Where I built the Compound bots', href: 'https://x.ai/bot' },
  { name: 'Hermes Agent', icon: '/images/stack/dock/hermes-agent.png', category: 'AI & Agents', desc: 'Agent harness', note: 'Agent orchestration layer', href: 'https://github.com/NousResearch/hermes-agent' },
  { name: 'Linear', icon: '/images/stack/linear.png', category: 'Productivity', desc: 'Issue tracking', note: "Tracks what I'm building", href: 'https://linear.app' },
  { name: 'Cursor', icon: '/images/stack/cursor.png', category: 'Building', desc: 'Code editor', note: 'For hands-on edits', href: 'https://cursor.com' },
  { name: 'Claude', icon: '/images/stack/dock/claude.png', category: 'AI & Agents', desc: 'AI assistant and Claude Code', note: 'Primary thinking partner', href: 'https://claude.ai' },
  { name: 'Beeper', icon: '/images/stack/dock/beeper.png', category: 'Communication', desc: 'All-in-one messaging', note: 'Inbox for everything', href: 'https://www.beeper.com', badge: '19', raw: true },
  { name: 'Coindock', icon: '/images/stack/dock/coindock.png', category: 'Crypto', desc: 'Prices in the dock', note: 'Markets at a glance' },
  { name: 'Dial', icon: '/images/listening/drake-iceman.jpg', category: 'Built by me', desc: 'Now playing, remembered.', note: 'Icon shows the album playing', href: '/projects', dial: true },
];
const defaultPick = dock.findIndex((item) => item.name === 'Claude');
const picked = dock[defaultPick];

// Dial's icon shows whatever album is playing; cycle through what I'm listening to.
const dialCovers = [
  'drake-iceman', 'kanye-bully', 'jcole-fall-off', 'chevelle-wonder-whats-next', 'deftones-private-music',
  'deftones-white-pony', 'deftones-diamond-eyes', 'juniorh-sad-boyz', 'pesopluma-dinastia', 'pesopluma-exodo',
].map((name) => `/images/listening/${name}.jpg`);

// Everything else from the stack, grouped as before. Claude Code lives in the dock as Claude.
const inDock = new Set([...dock.map((item) => item.name), 'Claude Code']);
const shelves = stackSections
  .map((section) => ({ ...section, items: section.items.filter((item) => !inDock.has(item.name)) }))
  .filter((section) => section.items.length > 0);

---

<Layout
  title="Stack — Tools & Apps Used by Juan Esquivel"
  description="Tools, apps, and gear that power Juan Esquivel's day-to-day. AI tools and agents, productivity apps, and creative software."
  canonicalPath="/stack"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="stack" />

  <header class="stack-header">
    <h1 class="stack-title">Stack</h1>
    <p class="stack-subtitle">The software I actually like using day to day. This is my actual dock.</p>
  </header>

  <figure class="dock-figure" data-dock>
    <ul class="dock" aria-label="Apps in my dock">
      {dock.map((item, i) => (
        <li class="dock-slot">
          <button
            type="button"
            class="dock-item"
            aria-label={item.name}
            aria-pressed={i === defaultPick ? 'true' : 'false'}
            data-index={i}
            data-name={item.name}
            data-category={item.category}
            data-desc={item.desc}
            data-note={item.note ?? ''}
            data-href={item.href ?? ''}
            data-icon={item.icon}
            data-raw={item.raw ? 'true' : 'false'}
          >
            <span class="dock-label" aria-hidden="true">{item.name}</span>
            <span class="dock-icon">
              <img
                src={item.icon}
                alt=""
                width="56"
                height="56"
                decoding="async"
                class:list={[{ 'dock-img--raw': item.raw }]}
                data-dial-cover={item.dial ? '' : undefined}
              />
              {item.badge && <span class="dock-badge" aria-hidden="true">{item.badge}</span>}
            </span>
            <span class="dock-dot" aria-hidden="true"></span>
          </button>
        </li>
      ))}
    </ul>
    <figcaption>Hover to magnify · click for the why</figcaption>
    <script type="application/json" data-dial-covers set:html={JSON.stringify(dialCovers)} />
  </figure>

  <section class="dock-detail" aria-live="polite" data-dock-detail>
    <img src={picked.icon} alt="" width="96" height="96" class:list={['dock-detail-icon', { 'dock-img--raw': picked.raw }]} data-detail-icon />
    <div class="dock-detail-body">
      <span class="dock-detail-category" data-detail-category>{picked.category}</span>
      <span class="dock-detail-name" data-detail-name>{picked.name}</span>
      <span class="dock-detail-desc" data-detail-desc>{picked.desc}</span>
    </div>
    <div class="dock-detail-side">
      <span class="dock-detail-note" data-detail-note>{picked.note}</span>
      <a href={picked.href} target="_blank" rel="noopener" class="dock-detail-link" data-detail-link>Visit <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <h2 class="stack-more-title">Also in rotation</h2>
  {shelves.map((section) => (
    <section class="stack-shelf">
      <div class="stack-shelf-head">
        <h3>{section.title}</h3>
        <p>{section.intro}</p>
      </div>
      <ul class="rotation-list">
        {section.items.map((item) => (
          <li>
            <a href={item.href} target="_blank" rel="noopener" class="rotation-row">
              <img src={item.icon} alt="" width="28" height="28" loading="lazy" decoding="async" />
              <span class="rotation-text">
                <span class="rotation-name">{item.name}</span>
                <span class="rotation-desc">{item.desc}</span>
              </span>
              {item.note && <span class="rotation-note">{item.note}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Layout>

<script>
  const dockRoot = document.querySelector<HTMLElement>('[data-dock]');
  const detail = document.querySelector<HTMLElement>('[data-dock-detail]');
  if (dockRoot && detail) {
    const items = [...dockRoot.querySelectorAll<HTMLButtonElement>('.dock-item')];
    const icon = detail.querySelector<HTMLImageElement>('[data-detail-icon]')!;
    const category = detail.querySelector<HTMLElement>('[data-detail-category]')!;
    const name = detail.querySelector<HTMLElement>('[data-detail-name]')!;
    const desc = detail.querySelector<HTMLElement>('[data-detail-desc]')!;
    const note = detail.querySelector<HTMLElement>('[data-detail-note]')!;
    const link = detail.querySelector<HTMLAnchorElement>('[data-detail-link]')!;
    const dialCover = dockRoot.querySelector<HTMLImageElement>('[data-dial-cover]');

    const show = (button: HTMLButtonElement) => {
      items.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      const d = button.dataset;
      const img = button.querySelector('img');
      icon.src = img?.src ?? d.icon ?? '';
      icon.classList.toggle('dock-img--raw', d.raw === 'true');
      category.textContent = d.category ?? '';
      name.textContent = d.name ?? '';
      desc.textContent = d.desc ?? '';
      note.textContent = d.note ?? '';
      link.hidden = !d.href;
      if (d.href) {
        link.href = d.href;
        const external = d.href.startsWith('http');
        link.target = external ? '_blank' : '';
        link.firstChild!.textContent = external ? 'Visit ' : 'See the project ';
      }
    };
    items.forEach((button) => button.addEventListener('click', () => show(button)));

    // Dial's icon shows the album playing.
    const covers: string[] = JSON.parse(dockRoot.querySelector('[data-dial-covers]')?.textContent ?? '[]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (dialCover && covers.length && !reduced.matches) {
      covers.forEach((src) => { const pre = new Image(); pre.src = src; });
      let n = 0;
      setInterval(() => {
        n = (n + 1) % covers.length;
        dialCover.src = covers[n];
        if (dialCover.closest('[aria-pressed="true"]')) icon.src = covers[n];
      }, 3500);
    }
  }
</script>

<style>
  .stack-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .stack-title {
    font-size: clamp(3rem, 7vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .stack-subtitle {
    color: var(--text-soft);
    line-height: 1.7;
  }

  .dock-figure {
    position: relative;
    left: 50%;
    width: min(1040px, calc(100vw - 2rem));
    transform: translateX(-50%);
    margin: 0 0 2.5rem;
    padding-top: 3.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .dock-figure figcaption {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .dock {
    max-width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-end;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem 0.4rem;
    list-style: none;
    border-radius: 24px;
    background: rgba(24, 22, 24, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 60px rgba(18, 14, 10, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .dock-item {
    position: relative;
    width: 56px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
  }

  .dock-icon {
    position: relative;
    display: block;
    width: 56px;
    height: 56px;
    transform-origin: 50% 100%;
    transition: transform 140ms var(--ease-out);
  }

  .dock-icon img {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 13px;
    object-fit: cover;
  }

  .dock-img--raw {
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .dock-badge {
    position: absolute;
    top: -5px;
    right: -5px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: #e5483b;
    color: #fff;
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 600;
    display: grid;
    place-items: center;
  }

  .dock-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgba(243, 241, 235, 0.45);
  }

  .dock-item[aria-pressed='true'] .dock-dot {
    background: #f3f1eb;
  }

  .dock-label {
    position: absolute;
    bottom: calc(100% + 34px);
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(30, 28, 30, 0.92);
    color: #f3f1eb;
    font-family: var(--font-ui);
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 120ms var(--ease-out);
    z-index: 2;
  }

  .dock-item:focus-visible {
    outline: none;
  }

  .dock-item:focus-visible .dock-icon img {
    outline: 2px solid #f3f1eb;
    outline-offset: 2px;
  }

  .dock-item:focus-visible .dock-label {
    opacity: 1;
  }

  /* macOS-style magnification: the hovered icon and its neighbors grow. */
  @media (hover: hover) and (pointer: fine) {
    .dock-slot:hover .dock-icon { transform: scale(1.45); }
    .dock-slot:hover .dock-label { opacity: 1; }
    .dock-slot:hover + .dock-slot .dock-icon,
    .dock-slot:has(+ .dock-slot:hover) .dock-icon { transform: scale(1.22); }
    .dock-slot:hover + .dock-slot + .dock-slot .dock-icon,
    .dock-slot:has(+ .dock-slot + .dock-slot:hover) .dock-icon { transform: scale(1.07); }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock-icon { transition: none; }
  }

  .dock-detail {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.75rem;
    padding: 1.75rem 0;
    margin-bottom: 4rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }

  .dock-detail::before {
    content: '';
    position: absolute;
    left: 0;
    top: -4px;
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  .dock-detail-icon {
    flex: 0 0 88px;
    width: 88px;
    height: 88px;
    border-radius: 20px;
    object-fit: cover;
    box-shadow: 0 10px 24px rgba(18, 14, 10, 0.16);
  }

  .dock-detail-body {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .dock-detail-category {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .dock-detail-name {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .dock-detail-desc {
    color: var(--text-soft);
  }

  .dock-detail-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .dock-detail-note {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--text-soft);
    text-align: right;
  }

  .dock-detail-link {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dock-detail-link[hidden] {
    display: none;
  }

  .stack-more-title {
    margin-bottom: 1.5rem;
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  .stack-shelf {
    margin-bottom: 2.25rem;
  }

  .stack-shelf-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .stack-shelf-head h3 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .stack-shelf-head p {
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .rotation-list {
    list-style: none;
  }

  .rotation-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
  }

  .rotation-row img {
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    border-radius: 7px;
    object-fit: contain;
  }

  .rotation-text {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .rotation-note {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--text-soft);
  }

  .rotation-name {
    font-weight: 500;
    font-size: 0.95rem;
  }

  .rotation-desc {
    color: var(--text-faint);
    font-size: 0.82rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .rotation-row:hover .rotation-name {
      color: var(--accent);
    }
  }

  @media (max-width: 640px) {
    .dock-detail-side {
      align-items: flex-start;
    }

    .dock-detail-note {
      text-align: left;
    }
  }
</style>
