        note: 'Issue tracking',
      },
      {
        name: 'Notion Calendar',
        desc: 'Calendar',
        href: 'https://www.notion.so/product/calendar',
        icon: '/images/stack/notion.png',
        note: 'Scheduling and time',
      },
      {
        name: 'Granola',
        desc: 'AI meeting notes',
        href: 'https://granola.ai',
