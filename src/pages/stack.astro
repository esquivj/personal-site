const totalTools = stackSections.reduce((count, section) => count + section.items.length, 0);
---

<Layout
  title="Stack — Tools & Apps Used by Juan Esquivel"
  description="Tools, apps, and gear that power Juan Esquivel's day-to-day. Development tools, productivity apps, and creative software."
  canonicalPath="/stack"
  preloadImages={['/images/stack/anthropic.jpg', '/images/stack/cursor.png', '/images/stack/ghostty.png']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="stack" />

  <PageHeader title="Stack" subtitle="The software I actually like using day to day." />


  {
    stackSections.map((section, sectionIndex) => (
      <section class="stack-shelf stack-breakout">
        <div class="stack-section-head">
          <span class="stack-section-kicker">{String(sectionIndex + 1).padStart(2, '0')}</span>
          <h2>{section.title}</h2>
          <p>{section.intro}</p>
        </div>

        <div class="stack-ledger">
          {section.items.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener"
              class="stack-ledger-row"
            >
              <div class="stack-ledger-icon">
                <img src={item.icon} alt={item.name} width="40" height="40" loading="lazy" decoding="async" class="contain" />
              </div>
              <div class="stack-ledger-body">
                <span class="stack-ledger-name">{item.name}</span>
                <span class="stack-ledger-desc">
                  {item.desc}{item.note && <em class="stack-ledger-note"> — {item.note}</em>}
                </span>
              </div>
              <UiIcon name="arrow-up-right" size={13} class="stack-ledger-arrow" />
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <p class="page-note stack-note">Hardware, gear, and everyday carry are next.</p>
</Layout>

<style>
  .stack-breakout {
    position: relative;
    left: 50%;
    width: min(720px, calc(100vw - 4rem));
    transform: translateX(-50%);
  }

  /* ── Daily Drivers Hero ── */

  .stack-stage {
    display: grid;
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    gap: 2.2rem;
    align-items: start;
    padding: 0 0 2.45rem;
    border-bottom: 1px solid var(--line);
  }

  .stack-stage-copy {
    max-width: 15.5rem;
    padding-top: 0.3rem;
  }

  .stack-stage-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    color: var(--text-faint);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .stack-stage-text {
    max-width: 22ch;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.72;
  }

  .stack-stage-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.75rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--text-faint);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stack-kicker-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* ── Driver Rows (hero list) ── */

  .stack-drivers {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    align-self: start;
  }

  .stack-driver-row {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      background 180ms var(--ease-out);
  }

  .stack-driver-icon {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(20, 19, 17, 0.1);
    background: rgba(20, 19, 17, 0.03);
    overflow: hidden;
    flex-shrink: 0;
  }

  .stack-driver-icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .stack-driver-icon img.contain {
    object-fit: contain;
    padding: 0.1rem;
  }

  .stack-driver-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .stack-driver-role {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-faint);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .stack-driver-arrow {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  /* ── Section Shelves ── */

  .stack-shelf {
    display: grid;
    grid-template-columns: 158px minmax(0, 1fr);
    gap: 1.6rem;
    align-items: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .stack-shelf:first-child {
    border-top: none;
  }

  .stack-shelf + .stack-shelf {
    margin-top: 2.5rem;
  }

  .stack-section-head {
    max-width: 14rem;
  }

  .stack-section-kicker {
    display: block;
    margin-bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.56rem;
    color: var(--text-faint);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack-section-head h2 {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .stack-section-head p {
    margin-top: 0.7rem;
    max-width: 18ch;
    color: var(--text-soft);
    font-size: 0.95rem;
    line-height: 1.72;
  }

  /* ── Ledger Rows (section items) ── */

  .stack-ledger {
    display: flex;
    flex-direction: column;
  }

  .stack-ledger-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition:
      background 180ms var(--ease-out);
  }

  .stack-ledger-row:first-child {
    border-top: 1px solid var(--line);
  }

  .stack-ledger-icon {
    width: 40px;
    height: 40px;
    border: 1px solid rgba(20, 19, 17, 0.1);
    background: rgba(20, 19, 17, 0.03);
    overflow: hidden;
    flex-shrink: 0;
  }

  .stack-ledger-icon img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .stack-ledger-icon img.contain {
    object-fit: contain;
    padding: 0.15rem;
  }

  .stack-ledger-body {
    min-width: 0;
  }

  .stack-ledger-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
  }

  .stack-ledger-desc {
    display: block;
    margin-top: 0.2rem;
    color: var(--text-soft);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .stack-ledger-note {
    color: var(--text-faint);
    font-style: italic;
  }

  .stack-ledger-arrow {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  /* ── Footer Note ── */

  .stack-note {
    width: min(720px, calc(100vw - 4rem));
    margin-top: 2.85rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  /* ── Hover States ── */

  @media (hover: hover) and (pointer: fine) {
    .stack-driver-row:hover {
      background: rgba(20, 19, 17, 0.02);
    }

    .stack-driver-row:hover .stack-driver-arrow {
      transform: translate(2px, -2px);
      color: var(--text);
    }

    .stack-ledger-row:hover {
      background: rgba(20, 19, 17, 0.02);
    }

    .stack-ledger-row:hover .stack-ledger-arrow {
      transform: translate(2px, -2px);
      color: var(--text);
    }
  }

  /* ── Responsive ── */

  @media (max-width: 960px) {
    .stack-breakout,
    .stack-note {
      left: auto;
      width: auto;
      transform: none;
    }

    .stack-stage {
      grid-template-columns: 1fr;
      gap: 1.35rem;
    }

    .stack-stage-copy {
      max-width: 34rem;
    }

    .stack-stage-text {
      max-width: 36ch;
    }

    .stack-shelf {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .stack-section-head {
      max-width: 34rem;
    }

    .stack-section-head p {
      max-width: 34ch;
    }
  }

  @media (max-width: 560px) {
    .stack-driver-row {
      grid-template-columns: 32px minmax(0, 1fr) auto;
      gap: 0.65rem;
    }

    .stack-driver-icon {
      width: 32px;
      height: 32px;
    }

    .stack-driver-role {
      display: none;
    }

    .stack-driver-name {
      font-size: 1.05rem;
    }

    .stack-ledger-row {
      grid-template-columns: 34px minmax(0, 1fr) auto;
      gap: 0.65rem;
    }

    .stack-ledger-icon {
      width: 34px;
      height: 34px;
    }

    .stack-ledger-name {
      font-size: 1rem;
    }

    .stack-ledger-desc {
      font-size: 0.84rem;
    }
  }
</style>
