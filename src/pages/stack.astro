---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { ethTile } from '../lib/eth-tile';
import AIActivity from '../components/AIActivity.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Juan Esquivel's Stack",
  url: 'https://juanesquivel.xyz/stack',
  description:
    'Tools, apps, and gear that Juan Esquivel uses daily for development, productivity, and creativity.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
