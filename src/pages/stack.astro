---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Juan Esquivel's Stack",
  url: 'https://juanesquivel.xyz/stack',
  description:
    'Tools, apps, and gear that Juan Esquivel uses daily for development, productivity, and creativity.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

const stackSections = [
  {
    title: 'Development',
    items: [
      {
        name: 'Claude Code',
        desc: 'AI coding assistant',
        href: 'https://claude.ai/code',
        icon: '/images/stack/anthropic.jpg',
        eager: true,
      },
      {
        name: 'Cursor',
        desc: 'AI-powered code editor',
        href: 'https://cursor.com',
        icon: '/images/stack/cursor.png',
        eager: true,
      },
      {
        name: 'Ghostty',
        desc: 'Terminal emulator',
        href: 'https://ghostty.org',
        icon: '/images/stack/ghostty.png',
        eager: true,
      },
      {
        name: 'OpenClaw',
        desc: 'AI computer use agent',
        href: 'https://openclaw.ai',
        icon: '/images/stack/openclaw.jpg',
      },
    ],
  },
  {
    title: 'Productivity',
    items: [
      {
        name: 'Obsidian',
        desc: 'Knowledge management',
        href: 'https://obsidian.md',
        icon: '/images/stack/obsidian.jpg',
      },
      {
        name: 'Notion',
        desc: 'Docs and wikis',
        href: 'https://notion.so',
        icon: '/images/stack/notion.png',
      },
      {
        name: 'Linear',
        desc: 'Project and task management',
        href: 'https://linear.app',
        icon: '/images/stack/linear.jpg',
      },
      {
        name: 'Amie',
        desc: 'Calendar',
        href: 'https://amie.so',
        icon: '/images/stack/amie.jpg',
      },
      {
        name: 'Granola',
        desc: 'AI meeting notes',
        href: 'https://granola.ai',
        icon: '/images/stack/granola.png',
      },
      {
        name: 'Things 3',
        desc: 'Task management',
        href: 'https://culturedcode.com/things/',
        icon: '/images/stack/things.jpg',
      },
    ],
  },
  {
    title: 'Browsing & Research',
    items: [
      {
        name: 'Dia',
        desc: 'Web browser',
        href: 'https://www.diabrowser.com',
        icon: '/images/stack/dia.png',
      },
      {
        name: 'Eagle',
        desc: 'Image and video library',
        href: 'https://eagle.cool',
        icon: '/images/stack/eagle.jpg',
      },
    ],
  },
  {
    title: 'Communication',
    items: [
      {
        name: 'Beeper',
        desc: 'All-in-one messaging',
        href: 'https://www.beeper.com',
        icon: '/images/stack/beeper.png',
      },
      {
        name: 'Notion Mail',
        desc: 'Email client',
        href: 'https://notion.so/product/mail',
        icon: '/images/stack/notion.png',
      },
    ],
  },
  {
    title: 'Music',
    items: [
      {
        name: 'Spotify',
        desc: 'Music streaming',
        href: 'https://spotify.com',
        icon: '/images/stack/spotify.png',
      },
    ],
  },
];
---

<Layout
  title="Stack — Tools & Apps Used by Juan Esquivel"
  description="Tools, apps, and gear that power Juan Esquivel's day-to-day. Development tools, productivity apps, and creative software."
  canonicalPath="/stack"
  preloadImages={['/images/stack/anthropic.jpg', '/images/stack/cursor.png', '/images/stack/ghostty.png']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="stack" />

  <PageHeader title="Stack" subtitle="Tools, apps, and gear that power my day-to-day." />

  {
    stackSections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <div class="surface-list">
          {section.items.map((item) => (
            <a href={item.href} target="_blank" rel="noopener" class="surface-link surface-link--stack">
              <div class="surface-media stack-media">
                <img
                  src={item.icon}
                  alt={item.name}
                  class="contain"
                  width="40"
                  height="40"
                  loading={item.eager ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
              <div class="surface-body">
                <span class="surface-title">{item.name}</span>
                <span class="surface-meta">{item.desc}</span>
              </div>
              <span class="surface-arrow">↗</span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <p class="page-note">Hardware, supplements, and gear coming soon.</p>
</Layout>

<style>
  .stack-media {
    border-radius: 22%;
    box-shadow:
      inset 0 1px 0 0 rgba(255, 255, 255, 0.08),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.03),
      0 1px 3px rgba(0, 0, 0, 0.26);
  }

  .page-note {
    margin-top: 2rem;
  }
</style>
