---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import UiIcon from '../components/UiIcon.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects by Juan Esquivel',
  url: 'https://juanesquivel.xyz/projects',
  description: 'Independent projects and experiments by Juan Esquivel.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

const projects = [
  {
    title: 'The Tokenization Map',
    domain: 'tokenizationmap.com',
    summary:
      "Who's building tokenization, how the stack connects, and where institutional capital is actually concentrating.",
    url: 'https://tokenizationmap.com',
    image: '/images/tokenizationmap-preview.jpg',
  },
];
---

<Layout
  title="Projects — Juan Esquivel"
  description="Independent projects and experiments by Juan Esquivel, including tokenizationmap.com."
  canonicalPath="/projects"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="projects" />

  <PageHeader
    title="Projects"
    subtitle="Projects built outside operating roles and client work."
  />

  <section class="projects-feature-list">
    {
      projects.map((project) => (
        <article class="project-feature">
          <div class="project-caption">
            <div class="project-main">
              <h2 class="project-title">{project.title}</h2>
              <p class="project-summary">{project.summary}</p>
            </div>

            <div class="project-meta">
              <a href={project.url} target="_blank" rel="noopener" class="project-link">
                Open site
                <UiIcon name="arrow-up-right" size={13} class="project-link-icon" />
              </a>
            </div>
          </div>

          <a
            href={project.url}
            target="_blank"
            rel="noopener"
            class="project-preview"
            aria-label={`Open ${project.title}`}
          >
            <img
              src={project.image}
              alt={`${project.title} website preview`}
              width="1200"
              height="630"
              loading="lazy"
              decoding="async"
            />
          </a>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .projects-feature-list {
    display: flex;
    flex-direction: column;
  }

  .project-feature {
    padding: 1.7rem 0 2rem;
    border-top: 1px solid var(--line);
  }

  .project-feature:last-child {
    border-bottom: 1px solid var(--line);
  }

  .project-preview {
    display: block;
    border: 1px solid var(--line);
    background: rgba(15, 15, 15, 0.96);
    overflow: hidden;
    width: min(100%, 43rem);
    margin-top: 1.55rem;
    margin-inline: auto;
    transition:
      border-color 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  .project-preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.8rem;
    align-items: end;
  }

  .project-main {
    max-width: 34rem;
  }

  .project-title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 3vw, 2.05rem);
    line-height: 0.98;
    font-weight: 400;
    letter-spacing: -0.03em;
    text-transform: none;
  }

  .project-summary {
    max-width: 50ch;
    font-size: 1rem;
    line-height: 1.74;
    color: var(--text-soft);
  }

  .project-meta {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding-bottom: 0.1rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }

  .project-link-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .project-preview:hover {
      transform: translateY(-1px);
      border-color: var(--line-strong);
    }

    .project-link:hover {
      color: var(--accent);
      border-color: currentColor;
    }
  }

  @media (max-width: 760px) {
    .project-caption {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .project-preview {
      width: 100%;
      margin-inline: 0;
    }

    .project-meta {
      align-items: flex-start;
      justify-content: flex-start;
    }
  }
</style>
