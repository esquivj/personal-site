---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import UiIcon from '../components/UiIcon.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects by Juan Esquivel',
  url: 'https://juanesquivel.xyz/projects',
  description: 'Independent projects and experiments by Juan Esquivel.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};

---

<Layout
  title="Projects — Juan Esquivel"
  description="Independent projects and experiments by Juan Esquivel, including tokenizationmap.com."
  canonicalPath="/projects"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="projects" />

  <PageHeader
    title="Projects"
    subtitle="Independent work built outside operating roles."
  />

  <article class="case-study">
    <header class="case-header">
      <span class="case-kicker">Independent project</span>
      <h2 class="case-title">The Tokenization Map</h2>
      <p class="case-description">
        An interactive infinite-canvas visualization mapping the entire tokenization landscape — who's building it, how the stack connects, and where institutional capital is actually concentrating. Not a directory. An opinionated cartography where every relationship is a claim.
      </p>
      <a
        href="https://tokenizationmap.com"
        target="_blank"
        rel="noopener"
        class="case-link"
      >
        Open site
        <UiIcon name="arrow-up-right" size={13} class="case-link-icon" />
      </a>
    </header>

    <figure class="case-figure">
      <a
        href="https://tokenizationmap.com"
        target="_blank"
        rel="noopener"
        class="case-image-link"
        data-domain="tokenizationmap.com"
      >
        <img
          src="/images/tokenizationmap-preview.jpg"
          alt="The Tokenization Map — interactive graph visualization of the tokenization landscape"
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      </a>
    </figure>

    <div class="stats-row">
      <div class="stat">
        <span class="stat-number">200+</span>
        <span class="stat-label">Players</span>
      </div>
      <div class="stat">
        <span class="stat-number">9</span>
        <span class="stat-label">Categories</span>
      </div>
      <div class="stat">
        <span class="stat-number">1,000+</span>
        <span class="stat-label">Relationships</span>
      </div>
      <div class="stat">
        <span class="stat-number">5</span>
        <span class="stat-label">Asset classes</span>
      </div>
    </div>

  </article>
</Layout>

<style>
  .case-study {
    border-top: 1px solid var(--line);
  }

  .case-header {
    padding: 2rem 0 0;
  }

  .case-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.65rem;
  }

  .case-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .case-description {
    font-size: 1.02rem;
    line-height: 1.74;
    color: var(--text-soft);
    margin: 0 0 1.4rem;
    max-width: 68ch;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out);
  }

  .case-link-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  /* Figure */
  .case-figure {
    margin: 2rem 0 0;
    padding: 0;
  }

  .case-image-link {
    position: relative;
    display: block;
    border: 1px solid var(--line);
    background: rgba(15, 15, 15, 0.96);
    overflow: hidden;
    transition:
      border-color 180ms var(--ease-out),
      transform 180ms var(--ease-out);
  }

  .case-image-link::after {
    content: attr(data-domain);
    position: absolute;
    top: 0.9rem;
    left: 0.9rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid rgba(243, 241, 235, 0.18);
    background: rgba(20, 19, 17, 0.68);
    color: rgba(243, 241, 235, 0.82);
    font-family: var(--font-mono);
    font-size: 0.54rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out);
    pointer-events: none;
  }

  .case-image-link img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 220ms var(--ease-out);
  }

  /* Stats */
  .stats-row {
    display: flex;
    gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-top: 2rem;
  }

  .stat {
    flex: 1;
    padding: 1.1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat + .stat {
    border-left: 1px solid var(--line);
    padding-left: 1.2rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Hover states */
  @media (hover: hover) and (pointer: fine) {
    .case-image-link:hover {
      transform: translateY(-1px);
      border-color: var(--line-strong);
    }

    .case-image-link:hover::after {
      opacity: 1;
      transform: translateY(0);
    }

    .case-image-link:hover img {
      transform: scale(1.012);
    }

    .case-link:hover {
      color: var(--accent);
      border-color: currentColor;
    }
  }

  /* Responsive */
  @media (max-width: 760px) {
    .case-header {
      max-width: none;
    }

    .stats-row {
      flex-wrap: wrap;
    }

    .stat {
      flex: 1 1 calc(50% - 0.5px);
      min-width: 0;
    }

    .stat:nth-child(1),
    .stat:nth-child(2) {
      border-bottom: 1px solid var(--line);
    }

    .stat:nth-child(2) {
      border-left: 1px solid var(--line);
      padding-left: 1.2rem;
    }

    .stat:nth-child(3) {
      border-left: none;
      padding-left: 0;
    }

    .stat:nth-child(4) {
      border-left: 1px solid var(--line);
      padding-left: 1.2rem;
    }

  }
</style>
