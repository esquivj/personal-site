---
import { projectsSchema } from '../data/schemas.mjs';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';

const projects = projectsSchema.parse([
  {
    number: '01',
    slug: 'compound-bots',
    kicker: 'Built on Grok Bot',
    title: 'Compound Grok Bots',
    line: 'Two agents I built on Grok Bot for my work at Compound Foundation.',
    description:
      'One pulls together a weekly read on community sentiment, with links to the conversations behind it. The other checks governance proposals every hour and flags what changed. Both are available as reusable Grok Bot templates.',
    facts: ['Weekly sentiment', 'Governance alerts', 'Reusable templates'],
    href: 'https://app.notion.com/p/cadenaa/AI-Agents-I-Built-For-Compound-40048e9e83398181a75ef2f6d03a7673',
    linkLabel: 'Read how I built them',
    image: {
      src: '/images/projects/compound-grok-bots.webp',
      alt: 'Compound Grok Bots illustrated as two Grok-style blob avatars in Compound green and pale mint on charcoal.',
      width: 1672,
      height: 941,
    },
  },
  {
    number: '02',
    slug: 'dial',
    kicker: 'Private software',
    title: 'Dial',
    line: 'Now playing, remembered.',
    description:
      "A tiny Y2K pocket shrine living inside macOS. Dial turns Spotify playback and listening history into a private music memory device: what's playing, what it means to you, and a pixel pet that grows as you listen.",
    facts: [
      'Native macOS app',
      'Spotify history import',
      'Menu bar player',
      'Pixel companion',
    ],
    image: {
      src: '/images/projects/dial-hero-v5-consistent-icons.webp',
      alt: 'Dial hero image with chrome wordmark, feature boxes, and black smoke gel macOS HUD playing Over the Top by Smiley and Drake',
      width: 1600,
      height: 900,
    },
  },
  {
    number: '03',
    slug: 'tokenization-map',
    kicker: 'Live project',
    title: 'The Tokenization Map',
    line: 'An opinionated map of the tokenization landscape.',
    description:
      'An interactive map of the tokenization landscape: who is building, how the stack connects, and where institutional capital is concentrating.',
    facts: ['Tokenization / RWA', '200+ players', '1,000+ relationships'],
    href: 'https://tokenizationmap.com',
    linkLabel: 'Explore the map',
    image: {
      src: '/images/tokenizationmap-preview.jpg',
      alt: 'The Tokenization Map interactive graph visualization of the tokenization landscape',
      width: 1200,
      height: 630,
    },
  },
]);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects by Juan Esquivel',
  url: 'https://juanesquivel.xyz/projects',
  description:
    'Software, tools, and experiments by Juan Esquivel, including Compound Grok Bots, Dial, and The Tokenization Map.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};
---

<Layout
  title="Projects — Juan Esquivel"
  description="Software, tools, and experiments by Juan Esquivel, including Compound Grok Bots, Dial, and The Tokenization Map."
  canonicalPath="/projects"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="projects" />

  <PageHeader title="Projects" subtitle={"Software, tools, and experiments I've built."} />

  <section class="projects-list" aria-label="Selected projects">
    {
      projects.map((project, index) => (
        <article class:list={['project-entry', { 'project-entry--flip': index % 2 === 1 }]}>
          {project.image && (
            <figure class="project-figure">
              {project.href ? (
                <a href={project.href} target="_blank" rel="noopener" class="project-image-frame project-image-frame--link" tabindex="-1" aria-hidden="true">
                  <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                </a>
              ) : (
                <div class="project-image-frame">
                  <img src={project.image.src} alt={project.image.alt} width={project.image.width} height={project.image.height} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                </div>
              )}
            </figure>
          )}

          <div class="project-copy">
            <div class="project-meta">
              <span class="project-number">{project.number}</span>
              <span class="project-kicker">{project.kicker}</span>
            </div>
            <h2 class="project-title">{project.title}</h2>
            <p class="project-line">{project.line}</p>
            <p class="project-description">{project.description}</p>

            {project.facts.length > 0 && (
              <ul class="project-facts" aria-label={`${project.title} highlights`}>
                {project.facts.map((fact) => <li>{fact}</li>)}
              </ul>
            )}

            {project.href && (
              <a href={project.href} target="_blank" rel="noopener" class="project-link">
                {project.linkLabel} <span class="project-link-arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </section>
</Layout>

<style>



  .project-entry {
    position: relative;
    left: 50%;
    width: min(1120px, calc(100vw - 4rem));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(2.5rem, 5vw, 3.5rem) 0;
    border-top: 1px solid var(--line-strong);
    margin: 0;
  }

  .project-entry--flip .project-figure {
    order: 2;
  }

  .project-figure {
    margin: 0;
  }

  .project-image-frame {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #1a1916;
  }

  .project-image-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 220ms var(--ease-out);
  }

  .project-copy {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .project-number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 8vw, 5.5rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--accent);
  }

  .project-kicker {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .project-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: none;
    color: var(--text);
    font-size: clamp(2.2rem, 4vw, 2.75rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .project-line {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--text-soft);
  }

  .project-description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-soft);
  }

  .project-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .project-facts li {
    padding: 0.4rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
  }

  .project-link {
    align-self: flex-start;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-link-arrow {
    display: inline-block;
    color: var(--accent);
    transition: transform 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-image-frame--link:hover img {
      transform: scale(1.012);
    }

    .project-link:hover .project-link-arrow {
      transform: translateX(3px);
    }
  }

  @media (max-width: 860px) {
    .project-entry {
      width: 100%;
      left: 0;
      transform: none;
      grid-template-columns: 1fr;
    }

    .project-entry--flip .project-figure {
      order: 0;
    }
  }
</style>
