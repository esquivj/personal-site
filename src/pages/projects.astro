---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import UiIcon from '../components/UiIcon.astro';

const projects = [
  {
    number: '01',
    slug: 'dial',
    kicker: 'Private software',
    title: 'Dial',
    line: 'Now playing, remembered.',
    description:
      "A tiny Y2K pocket shrine living inside macOS. Dial turns Spotify playback and listening history into a private music memory device: what's playing, what it means to you, and a pixel pet that grows as you listen.",
    facts: [
      'Native macOS app',
      'Spotify history import',
      'Menubar HUD',
      'Pixel pet system',
      'Private build',
    ],
    image: {
      src: '/images/projects/dial-hero-v5-consistent-icons.webp',
      alt: 'Dial hero image with chrome wordmark, feature boxes, and black smoke gel macOS HUD playing Over the Top by Smiley and Drake',
      width: 1600,
      height: 900,
    },
  },
  {
    number: '02',
    slug: 'tokenization-map',
    kicker: 'Live project',
    title: 'The Tokenization Map',
    line: 'An opinionated map of the tokenization landscape.',
    description:
      'An interactive map of the tokenization landscape: who is building, how the stack connects, and where institutional capital is concentrating.',
    facts: ['Tokenization / RWA', '200+ players', '1,000+ relationships', 'Live site'],
    href: 'https://tokenizationmap.com',
    linkLabel: 'Open site',
    image: {
      src: '/images/tokenizationmap-preview.jpg',
      alt: 'The Tokenization Map interactive graph visualization of the tokenization landscape',
      width: 1200,
      height: 630,
    },
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects by Juan Esquivel',
  url: 'https://juanesquivel.xyz/projects',
  description:
    'Projects built outside operating roles and client work, including Dial and The Tokenization Map.',
  author: {
    '@type': 'Person',
    name: 'Juan Esquivel',
    url: 'https://juanesquivel.xyz',
  },
};
---

<Layout
  title="Projects — Juan Esquivel"
  description="Projects built outside operating roles and client work, including Dial and The Tokenization Map."
  canonicalPath="/projects"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>
  <Nav active="projects" />

  <PageHeader title="Projects" subtitle="Projects built outside operating roles and client work." />

  <section class="projects-list" aria-label="Selected projects">
    {
      projects.map((project, index) => (
        <article class={`project-entry project-entry--${project.slug}`}>
          <div class="project-copy">
            <div class="project-body">
              <div class="project-meta" aria-label={`${project.number} ${project.kicker}`}>
                <span>{project.number}</span>
                <span>{project.kicker}</span>
              </div>
              <h2 class="project-title">{project.title}</h2>
              <p class="project-line">{project.line}</p>
              <p class="project-description">{project.description}</p>

              <ul class="project-facts" aria-label={`${project.title} details`}>
                {project.facts.map((fact) => (
                  <li>{fact}</li>
                ))}
              </ul>

              {project.href && (
                <a href={project.href} target="_blank" rel="noopener" class="project-link">
                  {project.linkLabel}
                  <UiIcon name="arrow-up-right" size={13} class="project-link-icon" />
                </a>
              )}
            </div>
          </div>

          <figure class="project-figure">
            {project.href ? (
              <a
                href={project.href}
                target="_blank"
                rel="noopener"
                class="project-image-frame project-image-frame--link"
              >
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width={project.image.width}
                  height={project.image.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
            ) : (
              <div class="project-image-frame">
                <img
                  src={project.image.src}
                  alt={project.image.alt}
                  width={project.image.width}
                  height={project.image.height}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            )}
          </figure>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .projects-list {
    border-top: 1px solid var(--line);
  }

  .project-entry {
    padding: clamp(2.5rem, 6vw, 4.75rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .project-entry:first-child {
    padding-top: clamp(2rem, 4.5vw, 3.5rem);
  }

  .project-copy {
    display: block;
    margin-bottom: clamp(1.45rem, 4vw, 2.35rem);
  }

  .project-meta,
  .project-facts,
  .project-link {
    font-family: var(--font-mono);
  }

  .project-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-faint);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    line-height: 1;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .project-meta span:first-child {
    color: var(--accent);
  }

  .project-meta span + span::before {
    content: '/';
    margin-right: 0.55rem;
    color: var(--line-strong);
  }

  .project-body {
    max-width: 74ch;
  }

  .project-title {
    font-family: var(--font-display);
    font-size: clamp(2.45rem, 6vw, 4.4rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 0.9;
    margin: 0;
    word-spacing: 0.06em;
  }

  .project-entry--tokenization-map .project-title {
    max-width: 16ch;
  }

  .project-line {
    color: var(--text);
    font-size: clamp(1.05rem, 2.1vw, 1.38rem);
    line-height: 1.35;
    margin: 1.15rem 0 0;
    max-width: 44rem;
  }

  .project-description {
    color: var(--text-soft);
    font-size: clamp(1rem, 1.5vw, 1.08rem);
    line-height: 1.72;
    margin: 1rem 0 0;
    max-width: 72ch;
  }

  .project-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
    list-style: none;
    margin: 1.35rem 0 0;
    padding: 0;
  }

  .project-facts li {
    border: 1px solid var(--line);
    color: var(--text-soft);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    line-height: 1;
    padding: 0.48rem 0.58rem;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    color: var(--text);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    margin-top: 1.35rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .project-link-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
  }

  .project-figure {
    margin: 0;
    padding: 0;
  }

  .project-image-frame {
    display: block;
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(15, 15, 15, 0.96);
  }

  .project-image-frame img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 220ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-link:hover {
      color: var(--accent);
      transform: translateX(2px);
    }

    .project-image-frame--link:hover img {
      transform: scale(1.012);
    }
  }

  @media (max-width: 760px) {
    .project-title {
      font-size: clamp(2.3rem, 14vw, 3.35rem);
      letter-spacing: -0.025em;
    }

    .project-entry--tokenization-map .project-title {
      font-size: clamp(2.15rem, 12vw, 3rem);
      max-width: 12ch;
    }
  }
</style>
