---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import TravelGlobe from '../components/TravelGlobe.astro';
import { travelStats } from '../data/travels';
import reference from '../data/travel-airports.json';
import { globeNetwork } from '../lib/travel-globe.mjs';

const { cities } = globeNetwork(travelStats, reference);

const summary = [
  `${cities.length} cities`,
  `${travelStats.totalCountries.toLocaleString('en-US')} countries`,
  `${travelStats.totalFlights.toLocaleString('en-US')} flights`,
].join(' · ');

const pageSchema = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: "Juan Esquivel's Travels",
  url: 'https://juanesquivel.xyz/travels', description: 'An interactive globe of the cities I have visited since 2018.',
  author: { '@type': 'Person', name: 'Juan Esquivel', url: 'https://juanesquivel.xyz' },
};
---

<Layout title="Travels — Juan Esquivel" description="An interactive globe of the cities I've visited since 2018, from my Flighty history." canonicalPath="/travels">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(pageSchema)} /></Fragment>
  <Nav active="travels" />

  <section class="travels-hero">
    <div class="travels-copy">
      <h1 class="travels-title">Where I've been, <em>so far.</em></h1>
      <p class="travels-summary">{summary}</p>
    </div>
    <div class="travels-globe">
      <TravelGlobe />
    </div>
  </section>
</Layout>

<style>
  .travels-hero {
    position: relative;
    left: 50%;
    width: min(1280px, calc(100vw - 4rem));
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    margin-bottom: 0;
  }
  .travels-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .travels-title {
    font-size: clamp(2.8rem, 5.6vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }
  .travels-title em {
    color: var(--text-faint);
  }
  .travels-summary {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .travels-globe {
    width: 100%;
    max-width: 820px;
    justify-self: end;
  }
  @media (max-width: 760px) {
    .travels-hero {
      width: 100%;
      left: 0;
      transform: none;
      grid-template-columns: 1fr;
    }
    .travels-globe {
      justify-self: center;
      max-width: none;
    }
  }
</style>
