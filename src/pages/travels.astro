---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import TravelGlobe from '../components/TravelGlobe.astro';
import { travelStats } from '../data/travels';
import reference from '../data/travel-airports.json';
import { globeNetwork } from '../lib/travel-globe.mjs';

const { cities } = globeNetwork(travelStats, reference);

const summary = [
  `${cities.length} cities`,
  `${travelStats.totalCountries.toLocaleString('en-US')} countries`,
  `${travelStats.totalFlights.toLocaleString('en-US')} flights`,
].join(' · ');

const pageSchema = {
  '@context': 'https://schema.org', '@type': 'WebPage', name: "Juan Esquivel's Travels",
  url: 'https://juanesquivel.xyz/travels', description: 'An interactive globe of the cities I have visited since 2018.',
  author: { '@type': 'Person', name: 'Juan Esquivel', url: 'https://juanesquivel.xyz' },
};
---

<Layout title="Travels — Juan Esquivel" description="An interactive globe of the cities I've visited since 2018, from my Flighty history." canonicalPath="/travels">
  <Fragment slot="head"><script type="application/ld+json" set:html={JSON.stringify(pageSchema)} /></Fragment>
  <Nav active="travels" />

  <PageHeader title="Travels" subtitle={"Where I've been, so far."} />
  <p class="travels-summary">{summary}</p>

  <section class="travels-stage" aria-label="Globe of cities visited">
    <div class="travels-hero">
      <TravelGlobe />
    </div>
    <div class="travels-legend" aria-hidden="true">
      <span><i class="key key-home"></i>Home</span>
      <span><i class="key key-previous"></i>Once home</span>
      <span><i class="key key-city"></i>Visited</span>
      <span class="travels-hint">Drag to spin · Click a city</span>
    </div>
  </section>
</Layout>

<style>
  :global(body) {
    overflow-x: clip;
  }

  .travels-summary {
    margin-top: -1.5rem;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* A full-bleed dark band so the globe reads as lit, not printed. */
  .travels-stage {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding: clamp(1.5rem, 4vw, 3rem) 16px clamp(1.25rem, 3vw, 2rem);
    background:
      radial-gradient(60% 55% at 50% 45%, rgba(224, 105, 74, 0.07), transparent 70%),
      #12110f;
    color: #f3f1eb;
  }

  .travels-hero {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
  }

  .travels-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    max-width: 760px;
    margin: 1rem auto 0;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(243, 241, 235, 0.55);
  }
  .travels-legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .travels-hint {
    margin-left: auto;
  }
  .key {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .key-home {
    background: #e0694a;
    box-shadow: 0 0 0 2px #12110f, 0 0 0 3px rgba(224, 105, 74, 0.6);
  }
  .key-previous {
    border: 1.5px solid #e0694a;
  }
  .key-city {
    width: 6px;
    height: 6px;
    background: #e0694a;
    box-shadow: 0 0 0 1.5px #f3f1eb;
  }
  @media (max-width: 520px) {
    .travels-legend .travels-hint {
      display: none;
    }
  }
</style>
