---
import Layout from '../../layouts/Layout.astro';
import { workCases, type WorkCase } from '../../data/work';

export function getStaticPaths() {
  return workCases.map(work => ({ params: { slug: work.slug }, props: { work } }));
}
interface Props { work: WorkCase }
const { work } = Astro.props;
const hasEvidence = work.sections.some(section => section.evidence.length > 0);
const next = workCases[(workCases.findIndex(item => item.slug === work.slug) + 1) % workCases.length];
---

<Layout title={`${work.title} — Juan Esquivel`} description={work.summary} canonicalPath={`/work/${work.slug}`} wide>
  <article class="case-study">
    <nav class="case-nav" aria-label="Page navigation"><a href="/work">← All work</a><a href="/JUAN-ESQUIVEL-resume.pdf">Résumé <span aria-hidden="true">↗</span></a></nav>
    <header class="case-header"><p class="case-role">{work.company} · {work.role}</p><h1>{work.title}</h1><p class="case-intro">{work.intro}</p></header>
    {!hasEvidence && <div class:list={['case-cover', work.imageStyle === 'contain' && 'case-cover--contain']}><img src={work.image.src} alt={work.image.alt} decoding="async" /></div>}
    <div class:list={['case-content', hasEvidence && 'case-content--illustrated']}>
      {work.sections.map((section, sectionIndex) => (
        <section>
          <div class="case-copy"><h2>{section.title}</h2><p>{section.text}</p></div>
          {section.evidence.length > 0 && (
            <div class:list={[
              'case-evidence',
              section.evidence.length > 1 && section.evidence.every(item => item.size === 'standard') && 'case-evidence--pair',
            ]}>
              {section.evidence.map(item => {
                const EvidenceTag = item.href ? 'a' : 'div';
                return (
                <figure class:list={[item.size === 'wide' && 'evidence--wide']}>
                  <EvidenceTag class="evidence-link" href={item.href} target={item.href ? '_blank' : undefined} rel={item.href ? 'noopener noreferrer' : undefined}>
                    <img src={item.src} alt={item.alt} width={item.width} height={item.height} loading={sectionIndex === 0 ? 'eager' : 'lazy'} decoding="async" />
                    {item.linkLabel && <span class="evidence-label">{item.linkLabel} <span aria-hidden="true">↗</span></span>}
                  </EvidenceTag>
                  {item.caption && <figcaption>{item.caption}</figcaption>}
                </figure>
              );})}
            </div>
          )}
        </section>
      ))}
    </div>
    {work.gallery.length > 0 && <div class="case-gallery">{work.gallery.map(item => <figure><a href={item.src} target="_blank" rel="noopener noreferrer" aria-label={`View full image: ${item.alt}`}><img src={item.src} alt={item.alt} loading="lazy" decoding="async" /></a>{item.caption && <figcaption>{item.caption}</figcaption>}</figure>)}</div>}
    {work.links.length > 0 && <nav class="case-links" aria-label="Published work">{work.links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</nav>}
    <footer class="case-footer"><a href="/work">← All work</a><a href={`/work/${next.slug}`}>Next: {next.title} <span aria-hidden="true">→</span></a></footer>
  </article>
</Layout>

<style>
  .case-nav,.case-footer{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-md)}
  .case-nav{margin-block-end:var(--space-xl)}
  .case-nav a,.case-footer a,.case-links a{display:inline-flex;align-items:center;gap:.4em;min-height:44px;text-decoration:none;font-size:.875rem}
  .case-header{max-width:740px;margin-block-end:var(--space-lg)}
  .case-role{font-size:.875rem;color:var(--text-faint);margin:0 0 var(--space-sm);text-wrap:pretty}
  .case-header h1{font-size:clamp(2.75rem,5.5vw,4.5rem);font-weight:400;line-height:1.05;margin:0 0 var(--space-md);text-wrap:balance}
  .case-intro{font-size:1.0625rem;line-height:1.65;margin:0;color:var(--text-soft);text-wrap:pretty}
  .case-cover{aspect-ratio:2;overflow:hidden;background:var(--bg-raised);margin-block-end:var(--space-xl)}
  .case-cover img{display:block;width:100%;height:100%;object-fit:cover}
  .case-cover--contain{background:#181b19}
  .case-cover--contain img{object-fit:contain}
  .case-content{max-width:680px;margin-inline:auto}
  .case-content--illustrated{max-width:none;padding-block-start:var(--space-lg)}
  .case-content.case-content--illustrated section{margin-block-end:var(--space-xl)}
  .case-copy{max-width:680px;margin-inline:auto}
  .case-content section{margin-block-end:var(--space-lg)}
  .case-content h2{font-family:var(--font-display);font-size:1.9rem;line-height:1.2;font-weight:400;text-transform:none;color:var(--text);margin:0 0 var(--space-sm);text-wrap:balance}
  .case-content p{font-size:1rem;line-height:1.75;color:var(--text-soft);margin:0;text-wrap:pretty}
  .case-evidence{display:grid;gap:var(--space-lg);margin-block-start:var(--space-lg)}
  .case-evidence--pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-lg);align-items:start}
  .case-evidence figure{width:100%;max-width:680px;margin:0 auto;min-width:0}
  .case-evidence figure.evidence--wide{max-width:none}
  .evidence-link{display:block;text-decoration:none}
  .evidence-link img{display:block;width:100%;height:auto;background:#111}
  .case-evidence--pair img{aspect-ratio:776/731;object-fit:contain;object-position:top}
  .evidence-label{display:inline-flex;align-items:center;gap:.4em;min-height:44px;margin-block-start:var(--space-xs);font-size:.875rem;text-decoration:underline;text-underline-offset:5px}
  .case-evidence figcaption{font-size:.875rem;line-height:1.5;color:var(--text-soft);margin-block-start:var(--space-xs)}
  .case-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-lg);margin-block:var(--space-xl)}
  .case-gallery figure{margin:0;min-width:0}
  .case-gallery a{display:block;background:var(--bg-raised)}
  .case-gallery img{display:block;width:100%;aspect-ratio:1.4;object-fit:contain}
  .case-gallery figcaption{font-size:.875rem;color:var(--text-soft);padding-block-start:var(--space-sm)}
  .case-links{display:flex;flex-wrap:wrap;gap:var(--space-lg);max-width:680px;margin:var(--space-lg) auto var(--space-xl)}
  .case-links a{text-decoration:underline;text-underline-offset:5px}
  .case-footer{border-block-start:1px solid var(--line);padding-block-start:var(--space-md);margin-block-end:var(--space-lg)}
  a:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
  @media(hover:hover) and (pointer:fine){a:hover{color:var(--accent)}}
  @media(max-width:640px){.case-gallery,.case-evidence--pair{grid-template-columns:minmax(0,1fr)}.case-cover{aspect-ratio:8/5}.case-nav{margin-block-end:var(--space-lg)}}
</style>
