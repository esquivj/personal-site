---
import Layout from '../layouts/Layout.astro';

const programs = [
  {
    title: 'Governance Lab', kind: 'Newsletter', image: '/work/governance-lab-cover.jpg',
    width: 1280, height: 640,
    description: 'A newsletter covering governance across the crypto ecosystem. I built it from zero and handled writing, curation, and distribution.',
    proof: '121 issues · 920+ subscribers · 38% average open rate',
    href: 'https://stablelab.substack.com', cta: 'Read the newsletter',
  },
  {
    title: 'StablePod', kind: 'Podcast', image: '/work/stablepod-cover.jpg',
    width: 600, height: 600,
    description: 'Conversations about protocols and governance with the people building them. I produced and co-hosted the series, deepening partner relationships along the way.',
    proof: '29 episodes · Guests from Morpho, Euler, Gnosis, and Uniswap Foundation',
    href: 'https://stablepod.vercel.app', cta: 'Explore the episodes',
  },
];
const extras = [
  { title: 'Sales materials', image: '/work/forse-insights.jpg', description: 'Product one-pagers and collateral for the BD team.' },
  { title: 'Team swag', image: '/work/swag/work-shirt.jpg', description: 'Creative direction for offsites and conferences.' },
  { title: 'Behind the scenes', image: '/work/behind-the-scenes-hq.avif', description: 'A record of team life, offsites, and time together.' },
];
---

<Layout title="Selected Work — Juan Esquivel" description="Selected marketing work at Compound Foundation and StableLab: launches, partner co-marketing, product positioning, and content programs." canonicalPath="/work">
  <div class="work-page">
    <nav class="page-nav" aria-label="Page navigation">
      <a href="/">← Juan Esquivel</a>
      <a href="/JUAN-ESQUIVEL-resume.pdf">Résumé <span aria-hidden="true">↗</span></a>
    </nav>

    <header class="work-intro">
      <p class="eyebrow">Selected work / 2023–2026</p>
      <h1>Selected <em>work.</em></h1>
      <p class="intro-copy">A few things I’ve helped launch, build, and grow at Compound Foundation and StableLab.</p>
    </header>

    <nav class="work-index" aria-label="Selected work">
      <a href="#compound"><span>01</span> Compound</a>
      <a href="#forse"><span>02</span> Forse</a>
      <a href="#content"><span>03</span> Content</a>
      <a href="#gathering"><span>04</span> In person</a>
    </nav>

    <section class="case" id="compound" aria-labelledby="compound-title">
      <div class="case-label"><span>01 / Compound Foundation</span><span>2026</span></div>
      <div class="case-opening">
        <div>
          <p class="eyebrow">Launches & partner co-marketing</p>
          <h2 id="compound-title">Compound Foundation.</h2>
        </div>
        <div class="case-summary">
          <p>Our own channels were small. Partners were the biggest opportunity to get Compound’s launches and long-standing integrations in front of more people.</p>
          <p class="role-line"><span>My part</span> Social launch sequencing, partner coordination, copy, and traction reporting.</p>
        </div>
      </div>

      <div class="compound-evidence">
        <div class="spotlight-result">
          <p class="eyebrow">Partner Spotlight</p>
          <p class="big-number">2.9<span>×</span></p>
          <p class="result-label">the median X views of other posts published during the same period.</p>
        </div>
        <div class="spotlight-context">
          <p class="evidence-heading">Long-standing integrations.<br />A reason to talk about them.</p>
          <p>I developed and ran a series highlighting the teams already building with Compound, coordinating partner copy and amplification.</p>
          <ul class="partner-names" aria-label="Spotlight partners">
            <li>Kiln</li><li>DeFi Saver</li><li>Chainlink</li><li>Sky</li>
          </ul>
        </div>
      </div>

      <div class="work-notes">
        <div><h3>The Institutional Market launch</h3><p>I owned the social launch sequence and partner coordination: partner-specific copy, publishing dates, direct outreach, and amplification.</p></div>
        <div><h3>Making traction visible</h3><p>I built a Dune dashboard with Claude to track deposits and collateral supplied. Growth stories gave BD proof to use in allocator conversations as the combined total reached $60M.</p></div>
      </div>
      <details class="case-detail">
        <summary>More on the workflow <span aria-hidden="true">+</span></summary>
        <div class="detail-copy"><p>The team and I established which market metrics mattered, using deposits and collateral supplied rather than TVL. Separately, I built a shared social analytics workflow with Claude, Hermes, and MCP to compare posts, track partner amplification, and produce weekly reports.</p><p class="evidence-note">The 2.9× figure compares cumulative median X views for the Partner Spotlight series with other posts from the same publishing period. It measures series performance, not the isolated effect of partner amplification.</p></div>
      </details>
    </section>

    <section class="case" id="forse" aria-labelledby="forse-title">
      <div class="case-label"><span>02 / Forse · StableLab</span><span>Launch & relaunch</span></div>
      <div class="case-opening">
        <div><p class="eyebrow">Brand & product positioning</p><h2 id="forse-title">Launching and<br />repositioning Forse.</h2></div>
        <div class="case-summary"><p>I led Forse’s naming, brand, and launch. When the buyers turned out to be foundations and protocol teams, we changed how the product presented itself.</p><p class="role-line"><span>My part</span> Positioning, messaging, website structure and copy, visual direction, and sales materials.</p></div>
      </div>
      <figure class="forse-hero">
        <a href="/work/forse-rebrand-hero.png" target="_blank" rel="noopener noreferrer" aria-label="Open the Forse visual direction at full size"><img src="/work/forse-rebrand-hero.png" alt="Forse brand and website visual direction" width="2992" height="1680" loading="lazy" /></a>
        <figcaption>Forse / Brand and website direction</figcaption>
      </figure>
      <div class="positioning-change">
        <div><span class="eyebrow">Where we started</span><p>Analytics for DAOs<br />and their communities.</p></div>
        <span class="change-arrow" aria-hidden="true">→</span>
        <div><span class="eyebrow">Where we landed</span><p>Growth intelligence for<br />foundations and protocol teams.</p></div>
      </div>
      <details class="case-detail">
        <summary>See the thinking and materials <span aria-hidden="true">+</span></summary>
        <div class="detail-copy"><p>The shift changed who the website was speaking to and what it needed to explain. I led the messaging and site structure, directed the visual refresh, and developed materials the sales team could use with those buyers.</p></div>
        <div class="material-pair">
          <figure><a href="/work/forse-workshop.png" target="_blank" rel="noopener noreferrer"><img src="/work/forse-workshop.png" alt="Forse brand workshop covering audience, vision, and positioning" loading="lazy" /></a><figcaption>Brand workshop</figcaption></figure>
          <figure><a href="/work/forse-brand-architecture.png" target="_blank" rel="noopener noreferrer"><img src="/work/forse-brand-architecture.png" alt="Forse brand architecture" loading="lazy" /></a><figcaption>Brand architecture</figcaption></figure>
        </div>
        <a class="text-link" href="https://stablelab.xyz/blog/reintroducing-forse-the-intelligence-layer-fueling-web3-growth" target="_blank" rel="noopener noreferrer">Read the relaunch <span aria-hidden="true">↗</span></a>
      </details>
    </section>

    <section class="case" id="content" aria-labelledby="content-title">
      <div class="case-label"><span>03 / StableLab</span><span>2023–2026</span></div>
      <div class="case-opening"><div><p class="eyebrow">Content & relationships</p><h2 id="content-title">Governance Lab<br />& StablePod.</h2></div><div class="case-summary"><p>I built recurring content programs that helped people follow governance and get to know the teams behind the protocols.</p><p class="role-line"><span>My part</span> Editorial direction, writing, production, guest coordination, and distribution.</p></div></div>
      <div class="programs">
        {programs.map(program => <article class="program">
          <a class:list={['program-image', program.kind === 'Podcast' && 'program-image--podcast']} href={program.href} target="_blank" rel="noopener noreferrer" aria-label={program.cta}><img src={program.image} alt={`${program.title} cover`} width={program.width} height={program.height} loading="lazy" /></a>
          <p class="eyebrow">{program.kind}</p><h3>{program.title}</h3><p>{program.description}</p><p class="program-proof">{program.proof}</p><a class="text-link" href={program.href} target="_blank" rel="noopener noreferrer">{program.cta} <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </section>

    <section class="case" id="gathering" aria-labelledby="gathering-title">
      <div class="case-label"><span>04 / StableLab</span><span>EthCC Brussels · 2024</span></div>
      <div class="gathering-layout">
        <figure><a href="/work/agg/event-4.jpg" target="_blank" rel="noopener noreferrer" aria-label="Open the Governance Gathering event photo"><img src="/work/agg/event-4.jpg" alt="Guests at Governance Gathering in Brussels" loading="lazy" /></a><figcaption>Governance Gathering / Brussels</figcaption></figure>
        <div class="gathering-copy"><p class="eyebrow">Events & business development</p><h2 id="gathering-title">Governance<br />Gathering.</h2><p>Governance Gathering brought industry partners and prospective clients together during EthCC Brussels.</p><p>I led the event, secured co-sponsors, and managed delivery. The purpose was simple: spend time with people we worked with and meet the teams we wanted to work with.</p><a class="text-link" href="https://lu.ma/l5tvcrcb" target="_blank" rel="noopener noreferrer">View the event <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="more-work" aria-labelledby="more-title">
      <div class="more-heading"><h2 id="more-title">A few other things.</h2><span class="eyebrow">From the StableLab years</span></div>
      <div class="extras">{extras.map(item => <figure><a href={item.image} target="_blank" rel="noopener noreferrer" aria-label={`Open ${item.title.toLowerCase()} image`}><img src={item.image} alt={item.title} loading="lazy" /></a><figcaption><strong>{item.title}</strong><span>{item.description}</span></figcaption></figure>)}</div>
    </section>
    <footer class="work-footer"><p>More context?</p><div><a class="text-link" href="/JUAN-ESQUIVEL-resume.pdf">Read my résumé <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:juanesquivel138@gmail.com">Get in touch <span aria-hidden="true">↗</span></a></div></footer>
  </div>
</Layout>

<style>
  .work-page{width:min(1120px,calc(100vw - 96px));position:relative;left:50%;transform:translateX(-50%);padding-bottom:2rem}
  .page-nav{display:flex;justify-content:space-between;align-items:center;margin:0 0 70px;font-size:.85rem;color:var(--text-soft)}
  .page-nav a,.text-link{display:inline-flex;align-items:center;gap:.35em;text-decoration:none}
  .page-nav a:hover,.text-link:hover{color:var(--accent)}
  .eyebrow,.case-label,.work-index span{font-family:var(--font-mono);font-size:.64rem;font-weight:400;letter-spacing:.09em;text-transform:uppercase;color:var(--text-faint)}
  .eyebrow{margin:0 0 16px}
  .work-intro{padding-bottom:42px}
  .work-intro h1{font-size:clamp(3.4rem,6.3vw,6rem);line-height:1.02;letter-spacing:-.045em;margin:0 0 24px;font-weight:400}
  .work-intro h1 em{font-weight:400;color:var(--text-soft)}
  .intro-copy{max-width:535px;font-size:1.08rem;line-height:1.6;color:var(--text-soft);margin:0}
  .work-index{display:flex;gap:36px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:18px 0;margin-bottom:68px}
  .work-index a{display:flex;gap:12px;align-items:center;text-decoration:none;font-size:.88rem}
  .work-index a:hover{color:var(--accent)}
  .work-index span{color:var(--accent);font-size:.58rem}
  .case{scroll-margin-top:32px;margin:0 0 80px}
  .case-label{display:flex;justify-content:space-between;gap:20px;border-top:1px solid var(--line);padding-top:15px;margin-bottom:34px}
  .case:first-of-type .case-label{border-top:0;padding-top:0}
  .case-label span:first-child{color:var(--accent)}
  .case-opening{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-bottom:32px;align-items:start}
  .case h2{font-family:var(--font-display);font-size:clamp(2.35rem,3.8vw,3.5rem);line-height:1.05;letter-spacing:-.035em;font-weight:400;color:var(--text);text-transform:none;margin:0}
  .case-summary{padding-top:26px}
  .case-summary p,.work-notes p,.gathering-copy>p,.detail-copy p{font-size:.94rem;line-height:1.65;color:var(--text-soft);margin:0 0 18px}
  .case-summary .role-line{font-size:.8rem;border-top:1px solid var(--line);padding-top:14px;margin:20px 0 0;line-height:1.7}
  .role-line span{color:var(--text);font-weight:500;margin-right:8px}
  .compound-evidence{display:grid;grid-template-columns:1fr 1fr;gap:64px;background:#e8eee7;border-top:1px solid #ced8cd;border-bottom:1px solid #ced8cd;padding:36px 40px;margin-bottom:28px}
  .spotlight-result .eyebrow{color:#4b5d4d;margin-bottom:6px}
  .big-number{font-family:var(--font-display);font-size:clamp(6rem,10vw,9rem);letter-spacing:-.065em;line-height:1;margin:0;color:#243c2e}
  .big-number span{font-size:.72em;margin-left:4px}
  .result-label{font-size:.84rem;line-height:1.55;max-width:295px;margin:14px 0 0;color:#47564a}
  .spotlight-context{align-self:center}
  .evidence-heading{font-family:var(--font-display);font-size:1.9rem;line-height:1.1;letter-spacing:-.02em;margin:0 0 16px;color:#243c2e}
  .spotlight-context>p:not(.evidence-heading){font-size:.88rem;line-height:1.6;color:#47564a;margin:0}
  .partner-names{display:flex;flex-wrap:wrap;gap:12px 22px;list-style:none;padding:18px 0 0;margin:22px 0 0;border-top:1px solid #c9d3c8;font-size:.82rem;color:#243c2e}
  .work-notes{display:grid;grid-template-columns:1fr 1fr;gap:64px;margin-bottom:14px}
  .work-notes h3{font-family:var(--font-ui);font-size:.92rem;letter-spacing:0;font-weight:500;margin:0 0 8px}
  .work-notes p{font-size:.86rem}
  .case-detail{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:0}
  .case-detail summary{display:flex;justify-content:space-between;align-items:center;min-height:52px;cursor:pointer;list-style:none;font-size:.81rem;font-weight:500;gap:20px}
  .case-detail summary::-webkit-details-marker{display:none}
  .case-detail summary span{font-size:1.2rem;font-weight:400;transition:transform .2s}
  .case-detail[open] summary span{transform:rotate(45deg)}
  .case-detail[open]{padding-bottom:24px}
  .detail-copy{max-width:740px;padding-top:12px}
  .detail-copy .evidence-note{font-size:.76rem;color:var(--text-faint)}
  figure{margin:0}
  figure a{display:block}
  figure img{display:block;width:100%;height:auto}
  figcaption{font-family:var(--font-mono);font-size:.58rem;letter-spacing:.03em;color:var(--text-faint);padding-top:10px;line-height:1.6}
  .forse-hero img{aspect-ratio:16/8.2;object-fit:cover;background:var(--bg-raised)}
  .positioning-change{display:grid;grid-template-columns:1fr auto 1fr;gap:36px;padding:24px 0 26px;align-items:center}
  .positioning-change .eyebrow{display:block;margin-bottom:10px}
  .positioning-change p{font-family:var(--font-display);font-size:1.7rem;line-height:1.15;letter-spacing:-.02em;margin:0}
  .change-arrow{color:var(--accent);font-size:1.7rem;margin:0 28px}
  .material-pair{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin:24px 0}
  .material-pair img{aspect-ratio:16/10;object-fit:contain;background:var(--bg-raised)}
  .text-link{font-size:.82rem;line-height:1.6;border-bottom:1px solid var(--line-strong);padding-bottom:3px;width:fit-content}
  .programs{display:grid;grid-template-columns:1fr 1fr;gap:48px}
  .program-image{height:245px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#e9e5dd;margin-bottom:24px}
  .program-image img{width:100%;height:100%;object-fit:cover}
  .program-image--podcast{background:#141614}
  .program-image--podcast img{width:auto;object-fit:contain}
  .program .eyebrow{margin-bottom:8px}
  .program h3{font-size:2.2rem;line-height:1.1;margin:0 0 15px;font-weight:400}
  .program>p:not(.eyebrow){font-size:.88rem;line-height:1.65;color:var(--text-soft);margin:0 0 16px}
  .program .program-proof{border-top:1px solid var(--line);padding-top:15px;font-size:.77rem!important;min-height:60px;color:var(--text)!important}
  .gathering-layout{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center}
  .gathering-layout img{aspect-ratio:1.18;object-fit:cover}
  .gathering-copy h2{margin-bottom:22px}
  .gathering-copy>p{font-size:.9rem}
  .more-work{border-top:1px solid var(--line);padding-top:24px;margin-bottom:66px}
  .more-heading{display:flex;justify-content:space-between;align-items:baseline;gap:20px;margin-bottom:24px}
  .more-heading h2{font-family:var(--font-display);font-size:2rem;text-transform:none;letter-spacing:-.025em;font-weight:400;margin:0;color:var(--text)}
  .more-heading .eyebrow{margin:0}
  .extras{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .extras img{height:195px;object-fit:cover;background:var(--bg-raised)}
  .extras figure:first-child img{object-position:top}
  .extras figcaption{font-family:var(--font-ui);letter-spacing:0;font-size:.79rem;padding-top:12px}
  .extras figcaption strong{display:block;color:var(--text);font-weight:500;font-size:.86rem;margin-bottom:3px}
  .extras figcaption span{display:block;line-height:1.55}
  .work-footer{border-top:1px solid var(--line);padding-top:26px;display:flex;justify-content:space-between;gap:24px;align-items:center}
  .work-footer>p{font-family:var(--font-display);font-size:2.1rem;margin:0}
  .work-footer>div{display:flex;gap:30px}
  a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
  @media(max-width:760px){
    .work-page{width:calc(100vw - 40px)}
    .page-nav{margin-bottom:48px;font-size:.78rem}
    .work-intro h1{font-size:clamp(2.9rem,9vw,4rem)}
    .intro-copy{font-size:.98rem}
    .work-intro{padding-bottom:28px}
    .work-index{gap:0;justify-content:space-between;flex-wrap:wrap;margin-bottom:40px;padding:15px 0}
    .work-index a{font-size:.76rem;gap:6px;min-height:30px}
    .work-index span{font-size:.52rem}
    .case{margin-bottom:54px}
    .case-label{margin-bottom:25px;font-size:.56rem;letter-spacing:.055em}
    .case-opening{grid-template-columns:1fr;gap:20px;margin-bottom:25px}
    .case h2{font-size:2.55rem}
    .case h2 br{display:none}
    .case-summary{padding-top:0}
    .case-summary .role-line{margin-top:15px}
    .compound-evidence{grid-template-columns:1fr;gap:28px;padding:26px}
    .big-number{font-size:7rem}
    .result-label{max-width:260px}
    .evidence-heading{font-size:1.7rem}
    .partner-names{gap:10px 20px;font-size:.78rem}
    .work-notes{grid-template-columns:1fr;gap:8px}
    .forse-hero img{aspect-ratio:16/10;object-fit:contain}
    .positioning-change{grid-template-columns:1fr;gap:15px;padding:22px 0}
    .positioning-change p{font-size:1.55rem}
    .positioning-change p br{display:none}
    .change-arrow{transform:rotate(90deg);width:fit-content;margin:0;font-size:1.4rem}
    .material-pair{grid-template-columns:1fr;gap:20px}
    .programs{grid-template-columns:1fr;gap:40px}
    .program-image{height:225px;margin-bottom:19px}
    .program .program-proof{min-height:0}
    .gathering-layout{grid-template-columns:1fr;gap:26px}
    .gathering-layout img{aspect-ratio:1.4}
    .more-heading{display:block}
    .more-heading h2{margin-bottom:10px}
    .extras{grid-template-columns:1fr;gap:26px}
    .extras img{height:240px}
    .work-footer{align-items:flex-start;flex-direction:column;gap:12px}
    .work-footer>div{gap:26px}
  }
  @media(prefers-reduced-motion:reduce){.case-detail summary span{transition:none}}
</style>
