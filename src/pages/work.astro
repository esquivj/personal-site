---
import Layout from '../layouts/Layout.astro';
import { workCases } from '../data/work';
---

<Layout title="Work — Juan Esquivel" description="Selected marketing work at Compound Foundation and StableLab." canonicalPath="/work" wide>
  <div class="portfolio">
    <nav class="portfolio-nav" aria-label="Page navigation">
      <a href="/">← Home</a>
      <a href="/JUAN-ESQUIVEL-resume.pdf">Résumé <span aria-hidden="true">↗</span></a>
    </nav>
    <header class="portfolio-header">
      <h1>Work</h1>
      <p>Selected marketing work at Compound Foundation and StableLab.</p>
    </header>
    <div class="work-grid">
      {workCases.map((work, index) => (
        <article class:list={['work-item', index === 4 && 'work-item--wide']}>
          <a class="work-link" href={`/work/${work.slug}`}>
            <div class:list={['work-cover', work.imageStyle === 'contain' && 'work-cover--contain']}>
              <img src={work.image.src} alt="" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
              <span class="view-work" aria-hidden="true">View work ↗</span>
            </div>
            <div class="work-caption">
              <h2>{work.title}<span aria-hidden="true">↗</span></h2>
              <p>{work.summary}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <footer class="portfolio-footer"><a href="/projects">Things I’m building <span aria-hidden="true">↗</span></a></footer>
  </div>
</Layout>

<style>
  .portfolio{padding-block-end:var(--space-lg)}
  .portfolio-nav{display:flex;justify-content:space-between;gap:var(--space-lg);margin-block-end:var(--space-xl)}
  .portfolio-nav a,.portfolio-footer a{display:inline-flex;align-items:center;gap:.4em;min-height:44px;font-size:.875rem;text-decoration:none}
  .portfolio-header{margin-block-end:var(--space-xl)}
  .portfolio-header h1{font-size:clamp(3.5rem,6vw,5rem);line-height:1.05;font-weight:400;margin:0 0 var(--space-sm);text-wrap:balance}
  .portfolio-header p{font-size:1rem;line-height:1.6;color:var(--text-soft);margin:0;max-width:38rem;text-wrap:pretty}
  .work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-xl) var(--space-lg)}
  .work-item{min-width:0}
  .work-link{display:block;text-decoration:none;color:inherit}
  .work-cover{position:relative;aspect-ratio:8/5;overflow:hidden;background:var(--bg-raised)}
  .work-cover img{display:block;width:100%;height:100%;object-fit:cover}
  .work-cover--contain{background:#181b19}
  .work-cover--contain img{object-fit:contain}
  .view-work{position:absolute;inset-inline-end:16px;inset-block-end:16px;padding:9px 13px;background:var(--bg);color:var(--text);font-size:.8rem;opacity:0;pointer-events:none}
  .work-caption{padding-block-start:var(--space-md)}
  .work-caption h2{display:flex;align-items:baseline;gap:.4em;font-family:var(--font-display);font-size:clamp(1.75rem,2.4vw,2.25rem);font-weight:400;text-transform:none;color:var(--text);line-height:1.15;margin:0 0 var(--space-xs);text-wrap:balance}
  .work-caption h2 span{font-family:var(--font-ui);font-size:.5em;flex-shrink:0}
  .work-caption p{font-size:1rem;line-height:1.55;margin:0;color:var(--text-soft);max-width:45ch;text-wrap:pretty}
  .work-item--wide{grid-column:1/-1}
  .work-item--wide .work-cover{aspect-ratio:2.5}
  .work-item--wide .work-cover img{object-position:center 44%}
  .portfolio-footer{margin-block-start:var(--space-xl);padding-block-start:var(--space-md);border-block-start:1px solid var(--line)}
  .portfolio-footer a{text-decoration:underline;text-underline-offset:5px}
  a:focus-visible{outline:2px solid var(--accent);outline-offset:6px}
  .work-link:focus-visible .view-work{opacity:1}
  @media(hover:hover) and (pointer:fine){.work-link:hover .view-work{opacity:1}.work-link:hover h2,.portfolio-nav a:hover,.portfolio-footer a:hover{color:var(--accent)}}
  @media(max-width:640px){.portfolio-nav{margin-block-end:var(--space-lg)}.work-grid{grid-template-columns:minmax(0,1fr);gap:var(--space-xl)}.portfolio-header{margin-block-end:var(--space-lg)}.work-item--wide{grid-column:auto}.work-item--wide .work-cover{aspect-ratio:8/5}.work-caption h2{font-size:1.9rem}}
</style>
