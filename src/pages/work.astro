---

<Layout
  title="Work Portfolio — Juan Esquivel's Marketing Projects"
  description="B2B marketing portfolio from Juan Esquivel's time at StableLab: services marketing, product launch, and sales enablement across three business phases."
  preloadImages={[
    '/work/partners.jpg',
    '/work/stablepod-cover.jpg',
    '/work/governance-lab-cover.jpg',
  ]}
>
  <header class="header">
    <a href="/" class="back-link">← Back</a>
  </header>

  <main>
    <section class="work-hero">
      <div class="work-hero-copy">
        <p class="work-kicker">StableLab / 2023–2026</p>
        <h1>Work</h1>
        <p class="hero-sub">
          Head of Marketing at StableLab. Three years of trust-first B2B marketing in crypto across
          services, product launch, and sales-led GTM.
        </p>
      </div>

      <div class="work-ledger">
        <div class="work-ledger-item">
          <span class="work-ledger-label">Role</span>
          <span class="work-ledger-value">Head of Marketing</span>
        </div>
        <div class="work-ledger-item">
          <span class="work-ledger-label">Focus</span>
          <span class="work-ledger-value">Content, brand, launches, sales support</span>
        </div>
        <div class="work-ledger-item">
          <span class="work-ledger-label">Context</span>
          <span class="work-ledger-value">Long sales cycles, relationship-led deals, credibility over clicks</span>
        </div>
      </div>
    </section>

    <section class="partner-stage">
      <div class="partner-stage-copy">
        <span class="section-index">Selected protocols</span>
        <h2>StableLab worked across 40+ protocols, foundations, and ecosystem teams.</h2>
        <p>
          The brand had to feel credible to both operators and governance teams. That trust carried
          the rest of the work.
        </p>
      </div>

      <button
        class="partners-trigger partner-stage-image"
        type="button"
        data-lightbox-src="/work/partners.jpg"
        data-lightbox-alt="StableLab partner logos"
      >
        <img
          src="/work/partners.jpg"
          alt="Partner logos: Aave, Arbitrum, Optimism, Uniswap, Lido, Compound, Gnosis, and 40+ more protocols"
          loading="eager"
          fetchpriority="high"
          width={getImageDimensions('/work/partners.jpg').width}
          height={getImageDimensions('/work/partners.jpg').height}
        />
      </button>
    </section>

    {
      phaseGroups.map((phase) => (
        <section class="phase-block">
          <div class="phase-rail">
            <span class="phase-number">{phase.number}</span>
            <div class="phase-copy">
              <h2>{phase.title}</h2>
              <span class="phase-years">{phase.years}</span>
              <p>{phase.summary}</p>
            </div>
          </div>

          <div class="phase-work">
            {
              phase.lead.length > 0 && (
                <div class:list={['feature-stack', phase.lead.length === 1 ? 'feature-stack--single' : 'feature-stack--duo']}>
                  {phase.lead.map((item) => {
                    const dims = getImageDimensions(item.image, { width: 1200, height: 900 });
                    return (
                      <button
                        class:list={[
                          'feature-case',
                          phase.lead.length === 1 && 'feature-case--single',
                          item.id === 'sales-enablement' && 'feature-case--cropped-teaser',
                        ]}
                        data-modal={item.id}
                        type="button"
                      >
                        <div class="feature-case-media">
                          <img src={item.image} alt={item.title} loading="eager" width={dims.width} height={dims.height} />
                        </div>
                        <div class="feature-case-body">
                          <div class="card-topline">
                            <span class="feature-case-kicker">{item.subtitle}</span>
                            <span class="card-open" aria-hidden="true">↗</span>
                          </div>
                          <h3>{item.title}</h3>
                          <p>{item.description}</p>
                          {proofBadgeById[item.id] && <span class="proof-chip">{proofBadgeById[item.id]}</span>}
                        </div>
                      </button>
                    );
                  })}
                </div>
              )
            }

            <div class:list={['case-grid', phase.items.length === 1 && 'case-grid--single', phase.items.length === 2 && 'case-grid--duo']}>
              {phase.items.map((item) => {
                const dims = getImageDimensions(item.image, { width: 1600, height: 900 });
                return (
                  <button class:list={['proof-card', item.id === 'sales-enablement' && 'proof-card--compact-media']} data-modal={item.id} type="button">
                    <div class="proof-card-media">
                      <img src={item.image} alt={item.title} loading="lazy" width={dims.width} height={dims.height} />
                    </div>
                    <div class="proof-card-body">
                      <div class="card-topline">
                        <span class="case-row-kicker">{item.subtitle}</span>
                        <span class="card-open" aria-hidden="true">↗</span>
                      </div>
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                      {proofBadgeById[item.id] && <span class="proof-chip">{proofBadgeById[item.id]}</span>}
                    </div>
                  </button>
                );
              })}
            </div>
          </div>
        </section>
      ))
    }

    <section class="phase-block phase-block--creative">
      <div class="phase-rail">
        <span class="phase-number">04</span>
        <div class="phase-copy">
          <h2>Creative</h2>
          <span class="phase-years">Supporting work</span>
          <p>Swag, content capture, and the softer proof that made the company feel real.</p>
        </div>
      </div>

      <div class="phase-work">
        <div class="creative-grid">
          <button class="creative-card creative-card--swag" data-modal="team-swag" type="button">
            <div class="swag-grid-large">
              {
                supportingWork.swag.previewImages.map((img, i) => {
                  const dims = getImageDimensions(img, { width: 600, height: 800 });
                  return (
                    <img
                      src={img}
                      alt="Team Swag"
                      loading="lazy"
                      class={i === 0 ? 'swag-main' : ''}
                      width={dims.width}
                      height={dims.height}
