---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
import WorkChapter, { type WorkChapterData } from '../components/WorkChapter.astro';
import { workChapterSchema } from '../data/schemas.mjs';

const chapters: WorkChapterData[] = [
  {
    label: '01 · Build', title: 'Own the channels',
    copy: 'I joined Compound Foundation as its first social and community hire and owned X and LinkedIn from day one.',
    stat: '+262%', statLabel: 'LinkedIn followers, 203 to 734',
    proof: { kind: 'post', name: 'Compound Foundation', handle: 'Compound_xyz', date: 'Jun 18, 2026', datetime: '2026-06-18', text: 'Welcome to the team Juan! @0xCadena', url: 'https://x.com/Compound_xyz/status/2067636256520179772' },
  },
  {
    label: '02 · Launch', title: 'Turn a launch into capital',
    copy: "I ran GTM for the $52M DAO-approved funding program and drove 125K+ views across the Foundation's own X posts with fewer than 4K followers. I then launched the Institutional Market with The Defiant, WBTC, and DeFi Saver, and the market reached $60M in capital supplied.",
    stat: '$60M', statLabel: 'capital supplied in the Institutional Market',
    proof: { kind: 'post', name: 'Compound Foundation', handle: 'Compound_xyz', date: 'Sep 25, 2026', datetime: '2026-09-25', text: 'The Compound Institutional Market has surpassed $60M in total deposits and collateral supplied.', image: { src: '/work/compound/feed/2103517844831125686.webp', width: 1200, height: 675, alt: "Video from @Compound_xyz's post", video: true }, url: 'https://x.com/Compound_xyz/status/2103517844831125686' },
  },
  {
    label: '03 · Systems', title: 'Run content as a system',
    copy: 'I built Claude-powered workflows that turn onchain data into content and Figma assets, plus the Institutional Market dashboard and daily brief. I ran weekly partner content with Sky and Chainlink and launched the monthly State of Compound recap.',
    stat: 'Weekly', statLabel: 'partner content with Sky and Chainlink',
    proof: { kind: 'post', name: 'Compound Foundation', handle: 'Compound_xyz', date: 'Jul 29, 2026', datetime: '2026-07-29', text: "… Compound has been powered by Chainlink Price Feeds to secure its lending markets. … Today's Partner Spotlight: @chainlink", image: { src: '/work/compound/feed/2082499430373372231.webp', width: 1200, height: 675, alt: "Image from @Compound_xyz's post" }, url: 'https://x.com/Compound_xyz/status/2082499430373372231' },
  },
  {
    label: '01 · Build', title: 'Build marketing from zero',
    copy: 'I built the marketing function from zero for a governance and crypto data infrastructure company serving 40+ protocol partners, including Uniswap, Aave, Arbitrum, and Sky. I repositioned StableLab across services, product development, and sales-led GTM.',
    stat: '40+', statLabel: 'protocol partners',
    proof: { kind: 'image', image: { src: '/work/partners.jpg', width: 1600, height: 800, alt: 'StableLab partner logos including Uniswap, Aave, Arbitrum, and Sky' } },
  },
  {
    label: '02 · Launch', title: 'Name and launch Forse',
    copy: 'I led product marketing for Forse across naming, brand identity, positioning, category framing, sales collateral, and the GTM launch.',
    stat: '800K+', statLabel: 'impressions and 18K+ unique visitors across two B2B brands',
    proof: { kind: 'image', image: { src: '/work/forse-launch-hero.webp', width: 1394, height: 732, alt: 'Forse launch visual' }, url: 'https://web.archive.org/web/20260114123639/https://stablelab.xyz/blog/introducing-forse-by-stablelab', linkLabel: 'Read the launch post (Wayback Machine)' },
  },
  {
    label: '03 · Systems', title: 'Keep the community close',
    copy: 'I grew the newsletter to 920+ subscribers and produced 27+ podcast episodes with crypto founders. I drove BD through co-marketing and IRL events, including a 150+ attendee side event at EthCC Brussels.',
    stat: '150+', statLabel: 'attendees at the EthCC Brussels side event',
    proof: { kind: 'image', image: { src: '/work/agg/event-4.jpg', width: 800, height: 800, alt: 'Governance Gathering poster at the EthCC Brussels side event', position: 'center 40%' } },
  },
].map((chapter) => workChapterSchema.parse(chapter));

const roles = [
  { id: 'compound', name: 'Compound Foundation', meta: 'Founding Social & Community Lead · 2026', chapters: chapters.slice(0, 3) },
  { id: 'stablelab', name: 'StableLab', meta: 'Head of Marketing · 2023 to 2026', chapters: chapters.slice(3) },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Juan Esquivel’s work',
  url: 'https://juanesquivel.xyz/work',
  about: ['Compound Foundation', 'StableLab'],
  hasPart: roles.map((role) => ({
    '@type': ['CreativeWork', 'WebPageElement'],
    name: role.name,
    url: `https://juanesquivel.xyz/work#${role.id}`,
  })),
};
---
<Layout canonicalPath="/work" title="Work — Juan Esquivel" description="Juan Esquivel led social and community at Compound Foundation and marketing at StableLab. Explore his work across social, content, product launches, and sales-led GTM.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Nav active="work" />
  <header class="work-hero">
    <p class="kicker">Compound Foundation + StableLab / 2023–2026</p>
    <h1>Work</h1>
    <p class="tagline">“Built my way in. Finding the ‘so what’ and making people care.”</p>
    <p class="intro">I ran social and community at Compound Foundation after three years as Head of Marketing at StableLab. Both roles follow one arc. I build the function, launch the product, and run the systems that keep people caring.</p>
  </header>
  {roles.map((role) => (
    <section id={role.id} aria-labelledby={`${role.id}-title`} class="role">
      <header class="role-header">
        <h2 id={`${role.id}-title`}>{role.name}</h2>
        <p>{role.meta}</p>
      </header>
      {role.chapters.map((chapter) => <WorkChapter chapter={chapter} />)}
    </section>
  ))}
</Layout>
<style>
  .work-hero { padding: 1rem 0 4.5rem; }
  .kicker { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.08em; color: var(--text-faint); line-height: 1.8; }
  h1 { font-size: clamp(4.5rem, 12vw, 7rem); line-height: 1; margin: 1.5rem 0 2rem; }
  .tagline { font-family: var(--font-display); font-style: italic; font-size: clamp(2rem, 5vw, 2.8rem); line-height: 1.18; max-width: 27ch; margin-bottom: 1.75rem; }
  .intro { max-width: 59ch; font-size: 1rem; line-height: 1.85; color: var(--text-soft); }
  .role { margin-bottom: 4rem; scroll-margin-top: 2rem; }
  .role-header { padding-bottom: 2rem; }
  .role-header h2 { font-family: var(--font-display); font-size: clamp(2.4rem, 6vw, 3.2rem); line-height: 1.1; font-weight: 400; letter-spacing: -0.04em; text-transform: none; color: var(--text); margin-bottom: 0.75rem; }
  .role-header p { font-size: 0.75rem; line-height: 1.7; color: var(--text-faint); }
  @media (max-width: 640px) {
    .work-hero { padding-bottom: 3.5rem; }
    .role { margin-bottom: 3rem; }
    :global(body:has(.work-hero) a), :global(body:has(.work-hero) .nav-toggle) { min-height: 44px; }
    :global(body:has(.work-hero) .nav-link), :global(body:has(.work-hero) .footer-links a) { display: inline-flex; align-items: center; }
    :global(body:has(.work-hero) .footer-links) { flex-wrap: wrap; }
    :global(body:has(.work-hero) .nav-links) { gap: 0; }
  }
</style>
