              }
            </div>
            <div class="creative-info">
              <div class="card-topline">
                <span class="case-row-kicker">Creative direction</span>
                <span class="card-open" aria-hidden="true">↗</span>
              </div>
              <h3>Team Swag</h3>
              <p>Offsites, conference merch, and internal artifacts that gave the team a visual culture.</p>
              <span class="proof-chip">{proofBadgeById['team-swag']}</span>
            </div>
          </button>

          <button class="creative-card creative-card--bts" data-modal="behind-the-scenes" type="button">
            <img
              src={behindTheScenes.image}
              alt="Behind the Scenes"
              loading="lazy"
              width={getImageDimensions(behindTheScenes.image).width}
              height={getImageDimensions(behindTheScenes.image).height}
            />
            <div class="creative-info creative-info--overlay">
              <div class="card-topline">
                <span class="case-row-kicker">Content capture</span>
                <span class="card-open" aria-hidden="true">↗</span>
              </div>
