              <span class="proof-chip">{proofBadgeById['behind-the-scenes']}</span>
            </div>
          </button>
        </div>
      </div>
    </section>
  </main>

  <!-- Modal -->
  <div class="modal-bg" id="modalBg">
    <div class="modal" id="modal" role="dialog" aria-modal="true">
      <button class="modal-x" id="modalX" aria-label="Close">
