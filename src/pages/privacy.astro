---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  url: 'https://juanesquivel.xyz/privacy',
};
---

<Layout
  title="Privacy Policy — Juan Esquivel"
  description="Privacy policy for juanesquivel.xyz. Learn what data is (and is not) collected, how analytics are handled, and how information is used."
  canonicalPath="/privacy"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
  </Fragment>

  <PageHeader
    title="Privacy Policy"
    subtitle="This site is a personal portfolio and blog. I do not sell or share personal information."
    compact={true}
  />

  <section class="prose privacy-prose">
    <h2>Analytics</h2>
    <p>Basic, privacy-focused analytics may be collected to understand site traffic. No advertising or tracking cookies are used.</p>

    <h2>Contact</h2>
    <p>If you email me, I will only use your information to respond.</p>
  </section>
</Layout>

<style>
  .privacy-prose {
    gap: 0.75rem;
  }

  .privacy-prose h2 {
    margin-top: 1.25rem;
    margin-bottom: 0;
  }
</style>
