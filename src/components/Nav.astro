---
interface Props {
  active?: 'home' | 'projects' | 'writing' | 'stack' | 'speaking' | 'now' | 'travels' | 'about';
}

const { active = 'home' } = Astro.props;
const linkClass = (key: Props['active']) => (key === active ? 'nav-link active' : 'nav-link');
---

<nav class="nav">
  <a href="/" class="nav-brand">
    <span class="nav-brand-text">Juan Esquivel</span>
  </a>
  <button class="nav-toggle" aria-label="Toggle menu">
    Index
  </button>
  <div class="nav-links">
    <a href="/" class={linkClass('home')}>Home</a>
    <a href="/projects" class={linkClass('projects')}>Projects</a>
    <a href="/writing" class={linkClass('writing')}>Writing</a>
    <a href="/speaking" class={linkClass('speaking')}>Speaking</a>
    <a href="/stack" class={linkClass('stack')}>Stack</a>
    <a href="/now" class={linkClass('now')}>Now</a>
    <a href="/travels" class={linkClass('travels')}>Travels</a>
    <a href="/about" class={linkClass('about')}>About</a>
  </div>
</nav>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const navLinks = document.querySelector('.nav-links');
  toggle?.addEventListener('click', () => {
    navLinks?.classList.toggle('open');
  });
</script>

<style>
  .nav {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    margin-bottom: 3.8rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    column-gap: 1.25rem;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    color: var(--text);
    white-space: nowrap;
  }

  .nav-brand-text {
    font-family: var(--font-ui);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    color: var(--text-faint);
    cursor: pointer;
    padding: 0.4rem 0.78rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      color 150ms var(--ease-out),
      border-color 150ms var(--ease-out),
      background-color 150ms var(--ease-out),
      transform 140ms var(--ease-out);
  }

  .nav-toggle:active {
    transform: scale(0.96);
  }

  .nav-links {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.2;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    transition: color 150ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-brand:hover {
      color: var(--text);
    }

    .nav-toggle:hover {
      color: var(--text);
      border-color: var(--line-strong);
      background: rgba(24, 21, 19, 0.04);
    }
  }

  @media (max-width: 640px) {
    .nav {
      grid-template-columns: 1fr auto;
      align-items: center;
      margin-bottom: 2.6rem;
    }

    .nav-toggle {
      display: block;
    }

    .nav-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      width: 100%;
      grid-column: 1 / -1;
      padding-top: 1rem;
      justify-content: flex-start;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 280ms var(--ease-out), opacity 200ms var(--ease-out);
    }

    .nav-links.open {
      max-height: 24rem;
      opacity: 1;
    }

    .nav-links .nav-link {
      opacity: 0;
      transform: translateY(6px);
      transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out), color 150ms var(--ease-out);
    }

    .nav-links.open .nav-link:nth-child(1) { opacity: 1; transform: none; transition-delay: 40ms; }
    .nav-links.open .nav-link:nth-child(2) { opacity: 1; transform: none; transition-delay: 80ms; }
    .nav-links.open .nav-link:nth-child(3) { opacity: 1; transform: none; transition-delay: 120ms; }
    .nav-links.open .nav-link:nth-child(4) { opacity: 1; transform: none; transition-delay: 160ms; }
    .nav-links.open .nav-link:nth-child(5) { opacity: 1; transform: none; transition-delay: 200ms; }
    .nav-links.open .nav-link:nth-child(6) { opacity: 1; transform: none; transition-delay: 240ms; }
    .nav-links.open .nav-link:nth-child(7) { opacity: 1; transform: none; transition-delay: 280ms; }
    .nav-links.open .nav-link:nth-child(8) { opacity: 1; transform: none; transition-delay: 320ms; }
  }
</style>
