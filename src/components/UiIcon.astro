---
interface Props {
  name:
    | 'mail'
    | 'brand-x'
    | 'brand-linkedin'
    | 'brand-github'
    | 'orbit'
    | 'arrow-up-right'
    | 'apps';
  size?: number;
  stroke?: number;
  class?: string;
}

const { name, size = 16, stroke = 1.6, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {
    name === 'mail' && (
      <>
        <path d="M3 7.5 12 13l9-5.5" />
        <rect x="3" y="6" width="18" height="12" rx="1.5" />
      </>
    )
  }
  {
    name === 'brand-x' && (
      <>
        <path
          d="M18.901 1.153h3.68l-8.04 9.19L24 22.847h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z"
          fill="currentColor"
          stroke="none"
        />
      </>
    )
  }
  {
    name === 'brand-linkedin' && (
      <>
        <rect x="4" y="4" width="16" height="16" rx="1.75" />
        <path d="M8.25 10.25v5.5" />
        <path d="M8.25 7.85h.01" />
        <path d="M12 15.75v-3.1a1.95 1.95 0 0 1 3.9 0v3.1" />
        <path d="M12 10.25v5.5" />
      </>
    )
  }
  {
    name === 'brand-github' && (
      <>
        <path d="M9 18c-4.5 1.5-4.5-2.5-6-3" />
        <path d="M15 21v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 3.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-6 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 3.77 5.44 5.44 0 0 0 3.5 7.52c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 17.13V21" />
      </>
    )
  }
  {
    name === 'orbit' && (
      <>
        <path d="M8 20c-2.2-1.1-3.5-2.7-3.5-4.5 0-3.59 4.03-6.5 9-6.5s9 2.91 9 6.5c0 1.8-1.3 3.4-3.5 4.5" />
        <path d="M16 4c2.2 1.1 3.5 2.7 3.5 4.5 0 3.59-4.03 6.5-9 6.5s-9-2.91-9-6.5C1.5 6.7 2.8 5.1 5 4" />
        <circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'arrow-up-right' && (
      <>
        <path d="M7 17 17 7" />
        <path d="M8 7h9v9" />
      </>
    )
  }
  {
    name === 'apps' && (
      <>
        <rect x="4" y="4" width="6" height="6" rx="1" />
        <rect x="14" y="4" width="6" height="6" rx="1" />
        <rect x="4" y="14" width="6" height="6" rx="1" />
        <rect x="14" y="14" width="6" height="6" rx="1" />
      </>
    )
  }
</svg>
