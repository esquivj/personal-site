---
import { geoOrthographic, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import landData from 'world-atlas/land-110m.json';
import { travelStats } from '../data/travels';
import reference from '../data/travel-airports.json';
import { landDots, globeNetwork } from '../lib/travel-globe.mjs';

const land = feature(landData as any, (landData as any).objects.land) as any;
const { cities, airports, routes } = globeNetwork(travelStats, reference);
const homes = { current: 'Los Angeles', previous: 'Lisbon' };
const payload = JSON.stringify({ land: landDots(land), cities, airports, routes, homes }).replace(/</g, '\\u003c');

// Static fallback for no-JS / no-WebGL, framed like the live globe's starting view.
const projection = geoOrthographic().scale(200).translate([250, 250]).rotate([118, -24]).clipAngle(90);
const path = geoPath(projection);
const byCode = Object.fromEntries(airports.map((a) => [a.code, a]));
const routeLines = routes.map((r) => ({
  type: 'LineString' as const,
  coordinates: [[byCode[r.from].lon, byCode[r.from].lat], [byCode[r.to].lon, byCode[r.to].lat]],
}));
const visibleCities = cities
  .map((c) => ({ c, p: projection([c.lon, c.lat]), d: path({ type: 'Point', coordinates: [c.lon, c.lat] }) }))
  .filter((x) => x.p && x.d);
const cityList = cities.map((c) => c.name).join(', ');
---

<figure class="travel-globe" data-travel-globe>
  <div class="globe-stage">
    <svg class="globe-fallback" data-globe-fallback viewBox="0 0 500 500" role="img" aria-label="Globe of the cities I've visited">
      <defs>
        <radialGradient id="globe-shade" cx="38%" cy="32%" r="75%">
          <stop offset="0%" stop-color="var(--globe-ink)" stop-opacity="0.02" />
          <stop offset="100%" stop-color="var(--globe-ink)" stop-opacity="0.1" />
        </radialGradient>
      </defs>
      <path d={path({ type: 'Sphere' })} fill="url(#globe-shade)" stroke="var(--globe-line)" />
      <path d={path(land)} fill="var(--globe-ink)" fill-opacity="0.16" stroke="var(--globe-line)" stroke-width="0.5" />
      {routeLines.map((line) => <path d={path(line)} fill="none" stroke="var(--globe-accent)" stroke-width="0.7" opacity="0.35" />)}
      {visibleCities.map(({ c, p }) =>
        c.name === homes.current ? (
          <g><circle cx={p![0]} cy={p![1]} r="8" fill="none" stroke="var(--globe-accent)" stroke-width="1.2" /><circle cx={p![0]} cy={p![1]} r="3.6" fill="var(--globe-accent)"><title>{c.name}, {c.country} (home)</title></circle></g>
        ) : c.name === homes.previous ? (
          <circle cx={p![0]} cy={p![1]} r="4.5" fill="none" stroke="var(--globe-accent)" stroke-width="1.4"><title>{c.name}, {c.country} (once home)</title></circle>
        ) : (
          <circle cx={p![0]} cy={p![1]} r="3.2" fill="var(--globe-accent)"><title>{c.name}, {c.country}</title></circle>
        ),
      )}
    </svg>
    <canvas
      class="globe-canvas"
      data-globe-canvas
      tabindex="0"
      role="img"
      aria-label="Interactive globe of the cities I've visited. Drag or use the arrow keys to rotate. Scroll, pinch, or press plus and minus to zoom. Click a city to see its routes. Press H to return home."
    ></canvas>
    <span class="globe-home-tag" data-globe-home={homes.current} hidden aria-hidden="true">Home</span>
    <span class="globe-home-tag is-previous" data-globe-home={homes.previous} hidden aria-hidden="true">Once home</span>
    <div class="globe-tip" data-globe-tip hidden aria-live="polite">
      <div class="globe-tip-card">
        <span class="globe-tip-city" data-tip-city></span>
        <span class="globe-tip-meta" data-tip-meta></span>
      </div>
    </div>
    <div class="globe-zoom" data-globe-controls>
      <button type="button" data-globe-zoom-in aria-label="Zoom in">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
      <button type="button" data-globe-zoom-out aria-label="Zoom out">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
      <button type="button" data-globe-home-button aria-label="Back to home" title="Back to home">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="7" cy="7" r="1.8" fill="currentColor" /></svg>
      </button>
    </div>
  </div>
  <figcaption class="globe-sr-only" data-globe-cities>Cities I've visited: {cityList}.</figcaption>
  <script type="application/json" data-globe-data set:html={payload} />
</figure>

<script>
  import { initTravelGlobe } from '../lib/travel-globe-client';
  document.querySelectorAll<HTMLElement>('[data-travel-globe]').forEach(initTravelGlobe);
</script>

<style>
  .travel-globe {
    /* The globe always sits on a dark stage. */
    --globe-ink: #f3f1eb;
    --globe-accent: #e0694a;
    --globe-line: rgba(243, 241, 235, 0.16);
    margin: 0;
    width: 100%;
  }
  .globe-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }
  .globe-fallback,
  .globe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe-canvas {
    /* Wider than the globe so zooming in can fill the stage; the page clips it. */
    top: -12%;
    left: 50%;
    width: 100vw;
    height: 124%;
    margin-left: -50vw;
    display: block;
    cursor: grab;
    touch-action: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms var(--ease-out);
  }
  .globe-canvas:active {
    cursor: grabbing;
  }
  .globe-canvas:focus-visible {
    outline: none;
  }
  /* Focus ring for keyboard users only, sized to the globe at the current zoom. */
  [data-globe-keyboard] .globe-stage::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(80% * var(--globe-zoom, 1) + 12px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border: 1px solid var(--globe-accent);
    border-radius: 50%;
    pointer-events: none;
  }
  [data-globe-state='ready'] .globe-canvas {
    opacity: 1;
    visibility: visible;
  }
  [data-globe-state='ready'] .globe-fallback {
    display: none;
  }
  [data-globe-state='fallback'] .globe-canvas {
    display: none;
  }
  .globe-tip {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: 2;
  }
  .globe-tip[hidden] {
    display: none;
  }
  .globe-tip-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.7rem 0.55rem;
    transform: translate(-50%, calc(-100% - 16px));
    background: #f3f1eb;
    border: 1px solid rgba(20, 19, 17, 0.12);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    animation: globe-tip-in 160ms var(--ease-out);
  }
  .globe-tip-city {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #141311;
  }
  .globe-tip-meta {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #716d66;
  }
  .globe-home-tag {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: 1;
    margin: -0.45rem 0 0 1.05rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--globe-ink);
    white-space: nowrap;
  }
  .globe-home-tag.is-previous {
    margin-left: 0.8rem;
    color: rgba(243, 241, 235, 0.55);
  }
  .globe-home-tag[hidden] {
    display: none;
  }
  @keyframes globe-tip-in {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-100% - 8px));
    }
  }
  .globe-zoom {
    position: absolute;
    right: 0;
    bottom: 0;
    display: none;
    flex-direction: column;
    border: 1px solid var(--globe-line);
    background: rgba(243, 241, 235, 0.04);
  }
  [data-globe-state='ready'] .globe-zoom {
    display: flex;
  }
  .globe-zoom button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(243, 241, 235, 0.7);
    cursor: pointer;
    transition: color 150ms var(--ease-out), background-color 150ms var(--ease-out);
  }
  .globe-zoom button + button {
    border-top: 1px solid var(--globe-line);
  }
  .globe-zoom button:focus-visible {
    outline: 1px solid var(--globe-accent);
    outline-offset: -1px;
  }
  .globe-zoom button:disabled {
    color: rgba(243, 241, 235, 0.22);
    cursor: default;
  }
  @media (hover: hover) and (pointer: fine) {
    .globe-zoom button:not(:disabled):hover {
      color: var(--globe-ink);
      background: rgba(243, 241, 235, 0.08);
    }
  }
  .globe-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
