---
import { geoOrthographic, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import landData from 'world-atlas/land-110m.json';
import { travelStats } from '../data/travels';
import reference from '../data/travel-airports.json';
import { landDots, globeNetwork } from '../lib/travel-globe.mjs';
import { travelCities } from '../lib/travel-cities.mjs';

const land = feature(landData as any, (landData as any).objects.land) as any;
const { airports, routes } = globeNetwork(travelStats, reference);
const payload = JSON.stringify({ land: landDots(land), airports, routes }).replace(/</g, '\\u003c');

// Static fallback for no-JS / no-WebGL, framed like the live globe's starting view.
const projection = geoOrthographic().scale(185).translate([250, 250]).rotate([118, -24]).clipAngle(90);
const path = geoPath(projection);
const byCode = Object.fromEntries(airports.map((a) => [a.code, a]));
const routeLines = routes.map((r) => ({
  type: 'LineString' as const,
  coordinates: [[byCode[r.from].lon, byCode[r.from].lat], [byCode[r.to].lon, byCode[r.to].lat]],
}));
const visibleAirports = airports
  .map((a) => ({ a, p: projection([a.lon, a.lat]), d: path({ type: 'Point', coordinates: [a.lon, a.lat] }) }))
  .filter((x) => x.p && x.d);
const cityList = travelCities(
  airports.map((a) => ({
    ...a,
    country: reference[a.code as keyof typeof reference].country,
    flights: routes.reduce((sum, r) => sum + (r.from === a.code || r.to === a.code ? r.count : 0), 0),
  })),
)
  .map((city: { name: string }) => city.name)
  .sort()
  .join(', ');
---

<figure class="travel-globe" data-travel-globe>
  <div class="globe-stage">
    <svg class="globe-fallback" data-globe-fallback viewBox="0 0 500 500" role="img" aria-label="Globe showing the routes I've flown">
      <path d={path({ type: 'Sphere' })} fill="none" stroke="var(--line)" />
      <path d={path(land)} fill="var(--surface-strong)" stroke="var(--line)" stroke-width="0.5" />
      {routeLines.map((line) => <path d={path(line)} fill="none" stroke="var(--accent)" stroke-width="0.8" opacity="0.45" />)}
      {visibleAirports.map(({ p }) => <circle cx={p![0]} cy={p![1]} r="2.6" fill="var(--accent)" />)}
    </svg>
    <canvas
      class="globe-canvas"
      data-globe-canvas
      tabindex="0"
      role="img"
      aria-label="Interactive globe of the routes I've flown. Drag, or use the arrow keys, to rotate."
    ></canvas>
  </div>
  <figcaption class="globe-sr-only" data-globe-cities>Cities in my flight history: {cityList}.</figcaption>
  <script type="application/json" data-globe-data set:html={payload} />
</figure>

<script>
  import { initTravelGlobe } from '../lib/travel-globe-client';
  document.querySelectorAll<HTMLElement>('[data-travel-globe]').forEach(initTravelGlobe);
</script>

<style>
  .travel-globe {
    margin: 0;
    width: 100%;
  }
  .globe-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }
  .globe-fallback,
  .globe-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .globe-canvas {
    display: block;
    cursor: grab;
    touch-action: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms var(--ease-out);
  }
  .globe-canvas:active {
    cursor: grabbing;
  }
  .globe-canvas:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
    border-radius: 50%;
  }
  [data-globe-state='ready'] .globe-canvas {
    opacity: 1;
    visibility: visible;
  }
  [data-globe-state='ready'] .globe-fallback {
    display: none;
  }
  [data-globe-state='fallback'] .globe-canvas {
    display: none;
  }
  .globe-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
