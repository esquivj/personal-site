---
import { geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import landData from 'world-atlas/land-110m.json';
import { travelStats } from '../data/travels';
import reference from '../data/travel-airports.json';
import { routeGeometry } from '../lib/travel-routes.mjs';
import { travelCities } from '../lib/travel-cities.mjs';

const airports = travelStats.airports.map(code => ({
  code, ...reference[code as keyof typeof reference],
  flights: travelStats.routes.reduce((sum, route) => sum + (route.from === code || route.to === code ? route.count : 0), 0),
}));
const cities = travelCities(airports, travelStats.landedAirports);
const routes = travelStats.routes.map(route => {
  const from = reference[route.from as keyof typeof reference];
  const to = reference[route.to as keyof typeof reference];
  return routeGeometry([from.lon, from.lat], [to.lon, to.lat]);
});
const projection = geoMercator().scale(158).translate([500, 330]);
const path = geoPath(projection);
const land = feature(landData as any, (landData as any).objects.land);
const payload = JSON.stringify({ cities, routes }).replace(/</g, '\\u003c');
---

<section class="flight-atlas" data-flight-atlas aria-label="Cities I have landed in">
  <div class="atlas-viewport">
    <div class="atlas-fallback" data-map-fallback>
      <svg viewBox="0 0 1000 530" role="img" aria-label="Cities I have landed in, connected by illustrative flight routes">
        <path d={path(land)} fill="#f3f0e8" stroke="#d4d3c9" stroke-width="0.5" />
        {routes.map(route => <path d={path(route)} fill="none" stroke="#b67560" stroke-width="0.8" opacity="0.28" />)}
        {cities.map((city, index) => {
          const p = projection([city.lon, city.lat])!;
          return <g><circle cx={p[0]} cy={p[1]} r="2.7" fill="#ae462d" stroke="#f7f5f1" stroke-width="1" />
            {index < 5 && <text x={p[0] + 7} y={p[1] + 3} font-size="10" fill="#494641">{city.name}</text>}
          </g>;
        })}
      </svg>
    </div>
    <div class="atlas-canvas" data-map-canvas aria-label="City map. Drag left or right to explore the world. Use arrow keys to pan and plus or minus to zoom."></div>
    <div class="atlas-map-note" data-map-note>Drag to explore</div>
  </div>
  <p class="atlas-sr-only">Cities with recorded arrivals, including connections: {cities.map(city => city.name).sort().join(', ')}.</p>
  <script type="application/json" data-map-data set:html={payload} />
</section>

<script>
  import { initTravelMap } from '../lib/travel-map';
  document.querySelectorAll<HTMLElement>('[data-flight-atlas]').forEach(initTravelMap);
</script>

<style is:global>
  .flight-atlas { color-scheme: light; }
  .flight-atlas .atlas-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .atlas-viewport { height: clamp(410px, 47vw, 570px); position: relative; background: #e8ece8; overflow: hidden; }
  .atlas-fallback, .atlas-canvas { position: absolute; inset: 0; }
  .atlas-fallback svg { width: 100%; height: 100%; object-fit: cover; }
  .atlas-fallback[hidden] { display: none; }
  .atlas-map-note { position: absolute; left: 1rem; bottom: 1rem; color: #62675e; font: .56rem var(--font-mono); letter-spacing: .025em; pointer-events: none; }
  .flight-atlas .maplibregl-canvas { cursor: grab; }
  .flight-atlas .maplibregl-canvas:active { cursor: grabbing; }
  .flight-atlas .maplibregl-ctrl-group { border-radius: 0; background: var(--bg-raised); border: 1px solid var(--line); box-shadow: none; }
  .flight-atlas .maplibregl-ctrl-group button { width: 30px; height: 30px; }
  .flight-atlas .maplibregl-ctrl-attrib { font: 9px/1.5 var(--font-ui); color: var(--text-faint); background: rgba(247,245,241,.75); }
  .flight-atlas .maplibregl-canvas:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .flight-atlas .maplibregl-ctrl-bottom-right { bottom: 4px; right: 4px; }
  @media (max-width: 720px) {
    .atlas-viewport { height: 420px; }
    .atlas-map-note { left: .75rem; bottom: .75rem; font-size: .5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .flight-atlas *, .flight-atlas *::before { transition: none !important; } }
</style>
