---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  canonicalPath?: string;
  preloadImages?: string[];
}

const SITE_URL = 'https://juanesquivel.xyz';
const DEFAULT_IMAGE = '/images/og-image.png';

const {
  title = 'Juan Esquivel — Marketing, Brand, Narrative',
  description = 'Juan Esquivel is a marketer based in Los Angeles. Previously led marketing at StableLab. Writing and work across content, brand, product, and narrative.',
  image = DEFAULT_IMAGE,
  type = 'website',
  publishedTime,
  canonicalPath,
  preloadImages = [],
} = Astro.props;

const canonicalURL = canonicalPath
  ? `${SITE_URL}${canonicalPath}`
  : new URL(Astro.url.pathname, SITE_URL).toString();
const ogImageURL = image.startsWith('http') ? image : `${SITE_URL}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,600&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600&f[]=martian-mono@400,500&display=swap"
      rel="stylesheet"
    />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Preload Images -->
    {
      preloadImages.map((src) => {
        const href = src.startsWith('http') ? src : `${SITE_URL}${src}`;
        return <link rel="preload" as="image" href={href} />;
      })
    }

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Juan Esquivel" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@0xCadena" />
    <meta name="twitter:creator" content="@0xCadena" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <title>{title}</title>

    <!-- Structured Data Slot -->
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="container">
      <main id="main-content">
        <slot />
      </main>
      <footer class="footer">
        <div class="footer-mark">
          <div class="footer-wordmark" aria-hidden="true" data-footer-wordmark>ESQUIVEL</div>
        </div>
        <div class="footer-meta">
          <p>© 2026 Juan Esquivel</p>
          <div class="footer-links">
            <a href="/privacy">Privacy</a>
            <a href="/contact">Contact</a>
          </div>
        </div>
      </footer>
    </div>
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
    <script>
      const fitFooterWordmark = () => {
        const wordmark = document.querySelector('[data-footer-wordmark]');
        const shell = wordmark?.parentElement;

        if (!(wordmark instanceof HTMLElement) || !(shell instanceof HTMLElement)) return;

        wordmark.style.setProperty('--footer-wordmark-scale', '1');
        const availableWidth = shell.clientWidth;
        const naturalWidth = wordmark.scrollWidth;

        if (!availableWidth || !naturalWidth) return;

        const scale = availableWidth / naturalWidth;
        wordmark.style.setProperty('--footer-wordmark-scale', String(scale));
      };

      const observer = new ResizeObserver(() => fitFooterWordmark());
      const wordmark = document.querySelector('[data-footer-wordmark]');

      if (wordmark?.parentElement) {
        observer.observe(wordmark.parentElement);
      }

      window.addEventListener('load', fitFooterWordmark);
      window.addEventListener('resize', fitFooterWordmark);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f3f1eb;
    --bg-raised: #f7f5f1;
    --surface: rgba(19, 18, 16, 0.02);
    --surface-strong: rgba(19, 18, 16, 0.04);
    --text: #141311;
    --text-soft: #494641;
    --text-faint: #716d66;
    --line: rgba(19, 18, 16, 0.12);
    --line-strong: rgba(19, 18, 16, 0.22);
    --accent: #c24a2d;
    --accent-soft: rgba(194, 74, 45, 0.08);
    --accent-glow: rgba(194, 74, 45, 0.16);
    --accent-secondary: #c24a2d;
    --shadow: 0 18px 48px rgba(18, 14, 10, 0.06);
    --space-2xs: 0.35rem;
    --space-xs: 0.6rem;
    --space-sm: 0.9rem;
    --space-md: 1.25rem;
    --space-lg: clamp(1.8rem, 2vw, 2.35rem);
    --space-xl: clamp(3rem, 5vw, 4rem);
    --space-2xl: clamp(4.5rem, 8vw, 6.5rem);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
    --font-display: 'Instrument Serif', 'Times New Roman', serif;
    --font-ui: 'Switzer', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --font-mono: 'Martian Mono', 'SF Mono', Monaco, 'Cascadia Code', monospace;
    --font-wordmark: 'Archivo', 'Arial Narrow', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-ui);
    background-color: var(--bg);
    color: var(--text);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
    font-variant-numeric: lining-nums proportional-nums;
  }

  /* Webkit scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--line-strong);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgba(24, 21, 19, 0.3);
  }

  body {
    min-height: 100vh;
    position: relative;
    background:
      radial-gradient(42% 28% at 18% 14%, rgba(173, 181, 191, 0.12), transparent 72%),
      radial-gradient(38% 24% at 82% 18%, rgba(255, 255, 255, 0.28), transparent 74%),
      radial-gradient(58% 32% at 50% 108%, rgba(201, 193, 181, 0.12), transparent 74%),
      radial-gradient(circle at top, rgba(255, 255, 255, 0.28), transparent 30%),
      linear-gradient(180deg, #f6f4ef 0%, #f0ede7 54%, #ebe7e1 100%);
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 34% at 50% -8%, rgba(255, 255, 255, 0.12), transparent 70%),
      radial-gradient(32% 22% at 30% 32%, rgba(255, 255, 255, 0.1), transparent 72%),
      radial-gradient(36% 28% at 72% 62%, rgba(163, 171, 182, 0.08), transparent 74%);
    pointer-events: none;
    z-index: -1;
  }

  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 180px 180px;
    opacity: 0.02;
    pointer-events: none;
    z-index: 1000;
    mix-blend-mode: multiply;
  }

  ::selection {
    background: rgba(177, 75, 52, 0.14);
    color: var(--text);
  }

  /* Skip link */
  .skip-link {
    position: absolute;
    left: 1rem;
    top: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--accent);
    color: #faf5ee;
    border-radius: 999px;
    transform: translateY(-200%);
    transition: transform 160ms var(--ease-out);
    z-index: 2000;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .container > *:not(footer) {
    animation: fadeInUp 0.32s var(--ease-out) backwards;
  }

  .container > *:nth-child(1) {
    animation-delay: 0ms;
  }
  .container > *:nth-child(2) {
    animation-delay: 60ms;
  }
  .container > *:nth-child(3) {
    animation-delay: 120ms;
  }
  .container > *:nth-child(4) {
    animation-delay: 180ms;
  }
  .container > *:nth-child(5) {
    animation-delay: 240ms;
  }
  .container > *:nth-child(6) {
    animation-delay: 300ms;
  }
  .container > *:nth-child(7) {
    animation-delay: 360ms;
  }
  .container > *:nth-child(8) {
    animation-delay: 420ms;
  }

  .container {
    max-width: 840px;
    margin: 0 auto;
    padding: 3.25rem 2rem 2.3rem;
  }

  main {
    display: block;
  }

  a {
    color: var(--text);
    text-decoration: none;
    transition: color 150ms var(--ease-out);
  }

  a:focus-visible,
  button:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  /* Typography */
  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.04em;
    color: var(--text);
  }

  /* Muted text */
  .text-muted {
    color: var(--text-soft);
  }

  .text-secondary {
    color: var(--text-soft);
  }

  /* Nav link underline animation */
  .nav-link {
    position: relative;
  }

  .nav-link.active {
    color: var(--text);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms var(--ease-out);
  }

  /* Section spacing */
  section {
    margin-bottom: var(--space-xl);
  }

  section h2 {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 1.1rem;
  }

  .page-header {
    margin-bottom: clamp(3rem, 5vw, 3.75rem);
  }

  .page-header--compact {
    margin-bottom: clamp(2.2rem, 4vw, 2.8rem);
  }

  .page-title {
    font-size: clamp(2.55rem, 4.4vw, 3.2rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
    margin-bottom: 0.85rem;
    color: var(--text);
  }

  .page-subtitle {
    max-width: 50ch;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.78;
  }

  .page-note {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .prose p {
    max-width: 63ch;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.82;
  }

  .prose .lead,
  .prose > p:first-child {
    color: var(--text);
    max-width: 40ch;
    font-size: 1.14rem;
    line-height: 1.68;
  }

  .surface-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .surface-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    transition:
      background 180ms var(--ease-out),
      border-color 180ms var(--ease-out),
      transform 160ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  .surface-link:active {
    transform: scale(0.985);
  }

  .surface-media {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(24, 21, 19, 0.04);
  }

  .surface-media--wide {
    width: 120px;
    height: 68px;
    border-radius: 2px;
  }

  .surface-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .surface-media img.contain {
    object-fit: contain;
    padding: 0.15rem;
  }

  .surface-body {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .surface-title {
    color: var(--text);
    font-size: 1.08rem;
    font-family: var(--font-display);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .surface-meta {
    color: var(--text-soft);
    font-size: 0.84rem;
    line-height: 1.62;
  }

  .surface-arrow {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .surface-card {
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
  }

  .surface-card-title {
    color: var(--text);
    font-size: 1.9rem;
    line-height: 1.02;
    letter-spacing: -0.05em;
    margin-bottom: 0.95rem;
  }

  .surface-card-copy {
    color: var(--text-soft);
    font-size: 0.98rem;
    line-height: 1.82;
  }

  .meta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding-top: 1rem;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .meta-item dt {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: 0.25rem;
  }

  .meta-item dd {
    color: var(--text-soft);
    font-size: 0.84rem;
  }

  .stat-hero {
    margin-bottom: 1.25rem;
  }

  .stat-hero-value {
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 9vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .stat-hero-label {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-top: 0.75rem;
  }

  .inline-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  .inline-stat {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .inline-stat-value {
    color: var(--text);
    font-size: 1.1rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .inline-stat-label,
  .inline-divider {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .mini-card-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
    margin-bottom: 3rem;
  }

  .mini-card {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
  }

  .mini-card-value {
    color: var(--text);
    font-size: 1rem;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .mini-card-label {
    font-family: var(--font-mono);
    display: block;
    margin-top: 0.25rem;
    color: var(--text-faint);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .tag-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .tag-chip {
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: transparent;
    color: var(--text-soft);
    font-size: 0.84rem;
  }

  @media (max-width: 720px) {
    .mini-card-grid,
    .tag-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .surface-link {
      padding: 0.9rem;
    }

    .surface-link--stack,
    .surface-link--speaking {
      align-items: flex-start;
    }

    .surface-media--wide {
      width: 96px;
      height: 56px;
    }

    .mini-card-grid,
    .tag-grid {
      grid-template-columns: 1fr;
    }
  }

  .footer {
    margin-top: 8.5rem;
    padding-top: 1.65rem;
    border-top: 1px solid var(--line);
    width: min(1440px, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .footer-mark {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    overflow: hidden;
  }

  .footer-wordmark {
    width: max-content;
    display: block;
    font-family: var(--font-wordmark);
    font-size: clamp(6rem, 14vw, 12rem);
    font-weight: 600;
    font-variation-settings: 'wdth' 125;
    line-height: 0.6;
    letter-spacing: -0.075em;
    color: rgba(20, 19, 17, 0.085);
    user-select: none;
    text-transform: uppercase;
    text-wrap: nowrap;
    margin: 0 auto;
    transform: scaleX(var(--footer-wordmark-scale, 1));
    transform-origin: center top;
    will-change: transform;
    text-shadow:
      1px 1px 0 rgba(255, 255, 255, 0.34),
      -1px -1px 0 rgba(17, 15, 13, 0.04),
      0 2px 12px rgba(17, 15, 13, 0.025);
  }

  .footer-meta {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: -0.1rem;
  }

  .footer-meta p {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1;
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links {
    font-family: var(--font-mono);
    display: flex;
    gap: 0.7rem;
    font-size: 0.62rem;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links a {
    color: var(--text-faint);
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover {
      color: var(--text);
    }

    .nav-link:hover {
      color: var(--text);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    .surface-link:hover {
      background: rgba(24, 21, 19, 0.035);
      border-color: var(--line-strong);
      color: var(--text);
      transform: translateY(-1px);
    }

    .surface-link:hover .surface-arrow {
      color: var(--accent);
    }

    .footer-links a:hover {
      color: var(--text);
    }

    .footer-wordmark:hover {
      color: rgba(20, 19, 17, 0.11);
    }
  }

  .nav-link.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }

  @media (max-width: 760px) {
    .container {
      padding: 1.5rem 1.15rem 1.4rem;
    }

    .footer {
      margin-top: 5.75rem;
      width: calc(100vw - 2.3rem);
    }

    .footer-wordmark {
      font-size: clamp(4.8rem, 20vw, 8.5rem);
    }
  }
</style>
